# Public address of the Zaroda API, as a BUYER'S BROWSER reaches it (the
# marketplace calls it from the shopper's phone, and from this app's server
# when rendering shop pages). The API's CORS_ORIGIN (apps/api/.env) must
# include this storefront's own address, or checkout and login will fail
# in the browser.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Where this storefront is served - used for page metadata and robots.txt.
NEXT_PUBLIC_SITE_URL="http://localhost:3006"
