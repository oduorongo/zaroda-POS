// ZARODA POS — core schema.
// See ../../../DESIGN.md for the full design rationale (§4 entity model, §5 ERD).
//
// Row-Level Security: every tenant-owned table below carries organizationId.
// Prisma has no RLS DSL, so the actual `CREATE POLICY` statements live in
// prisma/rls.sql and are applied separately (see prisma/README.md) after
// `prisma migrate dev`. Do not treat this schema file as the full security
// boundary — the RLS policies are what actually enforce tenant isolation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) - used at runtime
  directUrl = env("DIRECT_URL") // unpooled - used by `prisma migrate` only
}

// ─────────────────────────────────────────────────────────────────────────
// Identity / tenancy
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  CASHIER
  SUPERVISOR
  MANAGER
  OWNER
  AUDITOR
  CARETAKER // a landlord's on-site helper: records rent and logs repairs, nothing else (rental plans Starter and up, one per landlord)
}

model Organization {
  id            String    @id @default(uuid())
  name          String
  industryType  String // "RETAIL" | "RESTAURANT" | "PHARMACY" | "SALON" | ...
  country       String    @default("KE")
  baseCurrency  String    @default("KES") // ISO 4217 — see DESIGN.md §9
  // Tax/compliance identity for eTIMS (KRA VSCU) invoicing - not the eTIMS
  // integration itself (no invoice sync exists yet, see the backoffice
  // tax-settings screen's own comment), just the settings a tenant needs
  // to enter before that integration can be wired up.
  kraPin        String?
  vatRegistered Boolean   @default(false)
  // Letterhead for documents the business prints (invoices, delivery notes, receipts, statements).
  address       String?
  phone         String?
  email         String?
  // Printed at the foot of an invoice: who cheques are payable to, bank account, terms.
  invoiceFooter String?
  // Soft-delete for platform-admin "delete tenant" - a deactivated org
  // can't log in (tenant login + PIN login both check this) but every
  // row it owns is preserved, unlike a hard DELETE which would cascade
  // away all of it (branches/sales/audit history - see the FK
  // onDelete: Cascade on every child table below). Mirrors the same
  // isActive convention OrgUser already uses for staff deactivation.
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  schoolPortal              SchoolPortal?
  supplierSchools           SupplierSchool[]
  schoolOrders              SchoolOrder[]
  supplierInvoices          SupplierInvoice[]
  schoolDeliveries          SchoolDelivery[]
  supplierCreditNotes       SupplierCreditNote[]
  schoolQuotes              SchoolQuote[]
  schoolTenders             SchoolTender[]
  schoolComplianceDocs      SchoolComplianceDoc[]
  schoolContracts           SchoolContract[]
  supplierRetentionEvents   SupplierRetentionEvent[]
  schoolBadDebtSettings     SchoolBadDebtSettings?
  schoolCashflowSettings    SchoolCashflowSettings?
  schoolCashflowItems       SchoolCashflowItem[]
  schoolTenderNotices       SchoolTenderNotice[]
  etimsZReports             EtimsZReport[]
  etimsReceiptPrints        EtimsReceiptPrint[]
  schoolWriteOffs           SchoolWriteOff[]
  schoolProvisionEntries    SchoolProvisionEntry[]
  supplierPayments          SupplierPayment[]
  documentCounters          DocumentCounter[]
  branches                  Branch[]
  orgUsers                  OrgUser[]
  categories                Category[]
  products                  Product[]
  taxClasses                TaxClass[]
  sales                     Sale[]
  auditLogs                 AuditLog[]
  stockTransfers            StockTransfer[]
  stockTakes                StockTake[]
  lowStockAlerts            LowStockAlert[]
  customers                 Customer[]
  layaways                  Layaway[]
  restaurantTables          RestaurantTable[]
  restaurantTabs            RestaurantTab[]
  restaurantSettings        RestaurantSetting[]
  hotelRooms                HotelRoom[]
  hotelFolios               HotelFolio[]
  hotelSettings             HotelSetting?
  hotelTaxes                HotelTax[]
  hotelRateCards            HotelRateCard[]
  hotelSeasons              HotelSeason[]
  hotelMealPrices           HotelMealPrice[]
  hotelGuests               HotelGuest[]
  hotelNightAudits          HotelNightAudit[]
  hotelNotifications        HotelNotification[]
  rentalProperties          RentalProperty[]
  rentalUnits               RentalUnit[]
  rentalListings            RentalListing[]
  rentalListingPayments     RentalListingPayment[]
  restaurantDishes          RestaurantDish[]
  tableReservations         TableReservation[]
  hotelRoomTypes            HotelRoomType[]
  roomBookings              RoomBooking[]
  rentalTenants             RentalTenant[]
  rentalLeases              RentalLease[]
  rentalInvoices            RentalInvoice[]
  rentalPayments            RentalPayment[]
  rentalAllocations         RentalPaymentAllocation[]
  rentalSettings            RentalSettings?
  rentalRequests            RentalPaymentRequest[]
  rentalMaintenance         RentalMaintenanceRequest[]
  rentalExpenses            RentalExpense[]
  rentalMeterReadings       RentalMeterReading[]
  rentalReminderLogs        RentalReminderLog[]
  rentalCaretakerProperties RentalCaretakerProperty[]
  rentalPlatformInvoices    RentalPlatformInvoice[]
  kitchenStations           KitchenStation[]
  salonResources            SalonResource[]
  salonAppointments         SalonAppointment[]
  suppliers                 Supplier[]
  purchaseOrders            PurchaseOrder[]
  goodsReceipts             GoodsReceipt[]
  supplierBills             SupplierBill[]
  supplierBillPayments      SupplierBillPayment[]
  supplierBillCredits       SupplierBillCredit[]
  etimsSetting              EtimsSetting?
  etimsDevices              EtimsDevice[]
  etimsItems                EtimsItem[]
  etimsDocuments            EtimsDocument[]
  repackagings              Repackaging[]
  wasteLogs                 WasteLog[]
  expenses                  Expense[]
  productionOrders          ProductionOrder[]
  serviceJobs               ServiceJob[]
  payrollProfiles           PayrollProfile[]
  payrollRuns               PayrollRun[]
  rosterShifts              RosterShift[]
  mpesaStkRequests          MpesaStkRequest[]
  subscription              Subscription?
  onlineStore               OnlineStore?
  onlineOrders              OnlineOrder[]
  commissionInvoices        CommissionInvoice[]
  riders                    Rider[]
  // The marketing team (and the member of it) that onboarded this business. Set once, when a team
  // member creates the account; only the platform owner can change it. Self-signups have neither.
  salesTeamId               String?
  salesAgentId              String?
  // When the current member took over this shop (its sign-up date unless an admin reassigned it): the
  // member earns only from money Zaroda received after this, so a reassignment never back-pays history.
  salesAssignedAt           DateTime?
  salesTeam                 SalesTeam?                 @relation(fields: [salesTeamId], references: [id], onDelete: SetNull)
  salesAgent                SalesAgent?                @relation(fields: [salesAgentId], references: [id], onDelete: SetNull)
  deliveryJobs              DeliveryJob[]
  deliveryQuotes            DeliveryQuote[]
  deliveryJobContacts       DeliveryJobContact[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  county         String?
  subCounty      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  terminals             Terminal[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  shifts                Shift[]
  sales                 Sale[]
  stockTakes            StockTake[]
  transfersOut          StockTransfer[]        @relation("TransferFromBranch")
  transfersIn           StockTransfer[]        @relation("TransferToBranch")
  lowStockAlerts        LowStockAlert[]
  layaways              Layaway[]
  restaurantTables      RestaurantTable[]
  kitchenStations       KitchenStation[]
  restaurantTabs        RestaurantTab[]
  restaurantSettings    RestaurantSetting[]
  hotelRooms            HotelRoom[]
  salonResources        SalonResource[]
  salonAppointments     SalonAppointment[]
  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
  etimsDevice           EtimsDevice?
  repackagings          Repackaging[]
  wasteLogs             WasteLog[]
  expenses              Expense[]
  productionOrders      ProductionOrder[]
  serviceJobs           ServiceJob[]
  rosterShifts          RosterShift[]
  onlineStores          OnlineStore[]
  onlineOrders          OnlineOrder[]

  @@index([organizationId])
  @@map("branches")
}

model Terminal {
  id          String    @id @default(uuid())
  branchId    String
  deviceLabel String
  appVersion  String?
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())

  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shifts          Shift[]
  sales           Sale[]
  cashierSessions CashierSession[]
  syncOutboxItems SyncOutbox[]

  @@index([branchId])
  @@map("terminals")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  // PIN is for terminal quick-login, hashed separately from the account
  // password - short PINs are only ever compared within an org+terminal
  // scope, never used to look a user up account-wide.
  pinHash      String?
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orgUsers OrgUser[]

  @@map("users")
}

// A user's membership in an organization, with an optional branch scope
// (null = access to all branches) and a role. One user can belong to
// multiple organizations (e.g. an accountant contracted to several shops).
model OrgUser {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  branchId       String? // null = all branches in the org
  role           Role
  // Soft-delete, not a row DELETE - an OrgUser is referenced by
  // everything it ever did (sales as cashier, discount/refund approvals,
  // audit log actions...), so removing the row outright would mean
  // either cascading away real transaction history or hitting FK
  // conflicts. Deactivating just blocks new login (both password and
  // PIN) and drops off the terminal's cashier picker by default -
  // history stays intact and queryable.
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  caretakerProperties RentalCaretakerProperty[]
  shiftsOpened        Shift[]                   @relation("ShiftOpenedBy")
  salesCashier        Sale[]                    @relation("SaleCashier")
  discounts           Discount[]                @relation("DiscountApprovedBy")
  refunds             Refund[]                  @relation("RefundApprovedBy")
  auditActions        AuditLog[]                @relation("AuditActor")
  cashierSessions     CashierSession[]
  stockTransfers      StockTransfer[]
  stockTakes          StockTake[]
  purchaseOrders      PurchaseOrder[]
  repackagings        Repackaging[]
  wasteLogs           WasteLog[]
  productionOrders    ProductionOrder[]
  serviceJobs         ServiceJob[]
  payrollProfile      PayrollProfile?
  payslips            Payslip[]
  payrollRunsCreated  PayrollRun[]              @relation("PayrollRunCreatedBy")
  payrollRunsApproved PayrollRun[]              @relation("PayrollRunApprovedBy")
  rosterShifts        RosterShift[]             @relation("RosterShiftFor")
  rosterShiftsCreated RosterShift[]             @relation("RosterShiftCreatedBy")

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@map("org_users")
}

// ─────────────────────────────────────────────────────────────────────────
// Duty roster — planned shift assignments, distinct from both `Shift`
// (an actual till/cash-drawer session someone opened) and CashierSession
// (actual PIN-in/PIN-out clock times, which payroll's HOURLY calculation
// reads) - this is what a manager plans *before* the work happens, not a
// record of what happened. `published` gates visibility to the assigned
// staff member (enforced in the terminal PWA, not here) so a manager can
// draft a week's schedule before it's final - same "draft vs live" split
// as ProductionOrder's DRAFT status, just a boolean here since there's no
// multi-step lifecycle beyond published/not.
model RosterShift {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String
  orgUserId      String
  startTime      DateTime
  endTime        DateTime
  published      Boolean  @default(false)
  notes          String?
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orgUser      OrgUser      @relation("RosterShiftFor", fields: [orgUserId], references: [id], onDelete: Cascade)
  createdBy    OrgUser      @relation("RosterShiftCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([orgUserId])
  @@map("roster_shifts")
}

// ─────────────────────────────────────────────────────────────────────────
// Payroll — core, not industry-gated (every tenant has staff regardless of
// vertical), but opt-in per employee: an OrgUser with no PayrollProfile
// simply never appears in a generated PayrollRun, the same "absence means
// plain behavior" convention as RecipeIngredient (no recipe = plain stocked
// item). Statutory deduction math (PAYE, NSSF, SHIF, the Affordable
// Housing Levy) is hardcoded for Kenya only, same deferral as the loyalty
// earn/redeem rates above - a real config screen (and other countries'
// rules) is a follow-up once there's a back-office screen to put it in,
// not needed for a single-country pilot to be useful. See
// common/payroll/kenya-statutory.util.ts for the actual bands/rates.
enum PayType {
  SALARY
  HOURLY
}

model PayrollProfile {
  id             String   @id @default(uuid())
  organizationId String
  orgUserId      String   @unique
  payType        PayType
  // For SALARY: the fixed monthly gross. For HOURLY: the rate multiplied
  // by hours actually clocked (via CashierSession) within the pay period.
  baseSalary     Decimal? @db.Decimal(12, 2)
  hourlyRate     Decimal? @db.Decimal(12, 2)
  kraPin         String?
  nssfNumber     String?
  shifNumber     String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgUser      OrgUser      @relation(fields: [orgUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("payroll_profiles")
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
  PAID
}

model PayrollRun {
  id             String           @id @default(uuid())
  organizationId String
  periodStart    DateTime
  periodEnd      DateTime
  status         PayrollRunStatus @default(DRAFT)
  createdById    String
  approvedById   String?
  approvedAt     DateTime?
  paidAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    OrgUser      @relation("PayrollRunCreatedBy", fields: [createdById], references: [id])
  approvedBy   OrgUser?     @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id])
  payslips     Payslip[]

  @@index([organizationId])
  @@map("payroll_runs")
}

// One row per employee per run - generated (not hand-entered) from that
// employee's PayrollProfile plus, for HOURLY staff, their CashierSessions
// within [periodStart, periodEnd). Deduction fields are snapshotted at
// generation time, same "snapshot what was actually agreed/calculated,
// don't trust it to still match today" reasoning as
// SaleLineItemIngredient - re-running statutory rates later must not
// silently change a payslip that's already been approved or paid.
model Payslip {
  id              String   @id @default(uuid())
  payrollRunId    String
  orgUserId       String
  payType         PayType
  hoursWorked     Decimal? @db.Decimal(8, 2)
  grossPay        Decimal  @db.Decimal(12, 2)
  payeTax         Decimal  @db.Decimal(12, 2)
  nssfDeduction   Decimal  @db.Decimal(12, 2)
  shifDeduction   Decimal  @db.Decimal(12, 2)
  housingLevy     Decimal  @db.Decimal(12, 2)
  totalDeductions Decimal  @db.Decimal(12, 2)
  netPay          Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  orgUser    OrgUser    @relation(fields: [orgUserId], references: [id])

  @@unique([payrollRunId, orgUserId])
  @@index([payrollRunId])
  @@map("payslips")
}

// Shared-terminal PIN switching (DESIGN.md §9): a terminal is authenticated
// at the device level, but each sale is attributed to whichever cashier is
// currently "swiped in" here, not to the device session.
model CashierSession {
  id           String    @id @default(uuid())
  terminalId   String
  orgUserId    String
  pinStartedAt DateTime  @default(now())
  pinEndedAt   DateTime?

  terminal Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  orgUser  OrgUser  @relation(fields: [orgUserId], references: [id], onDelete: Cascade)
  sales    Sale[]

  @@index([terminalId])
  @@index([orgUserId])
  @@map("cashier_sessions")
}

// ─────────────────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────────────────

model Category {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@index([organizationId])
  @@map("categories")
}

model TaxClass {
  id             String  @id @default(uuid())
  organizationId String
  name           String
  rate           Decimal @db.Decimal(6, 4) // e.g. 0.1600 for 16% VAT
  isExempt       Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@index([organizationId])
  @@map("tax_classes")
}

model Product {
  id                String   @id @default(uuid())
  organizationId    String
  categoryId        String?
  taxClassId        String?
  name              String
  baseUnit          String   @default("each")
  // Online Shop add-on: whether this product appears in the business's
  // public shop (only once the shop itself is live - see OnlineStore), and
  // the buyer-facing description shown there. Online price and stock are
  // NOT separate fields - they come from the variants' price and the
  // fulfilment branch's inventory, so the counter and the web never
  // disagree.
  onlineVisible     Boolean  @default(false)
  onlineDescription String?
  /// False once archived: hidden from the till, the table menu, the online shop and the school price list, but kept for reports and history.
  isActive          Boolean  @default(true)
  archivedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  taxClass     TaxClass?            @relation(fields: [taxClassId], references: [id], onDelete: SetNull)
  variants     ProductVariant[]
  pharmacyFlag PharmacyProductFlag?
  images       ProductImage[]

  @@index([organizationId])
  @@map("products")
}

// COUNT = sold/stocked in whole units (each, pack, box - the default).
// WEIGHT = sold/stocked in fractional quantities of the variant's unit (kg,
// litre, ...) - a scoop of loose rice or a ladle of cooking oil doesn't
// come in fixed-size units, so quantity has to allow e.g. 0.35. Every
// quantity-bearing column downstream (sale/inventory/batch/transfer/
// purchase-order/repackaging) is Decimal(14,3) precisely so COUNT and
// WEIGHT variants can share the same columns - COUNT just never produces a
// fractional value, enforced in the service layer (see SalesService,
// InventoryTransactionsService) rather than at the database level, since
// Postgres has no per-row "this decimal must be an integer" constraint
// that's cheap to express here.
enum QuantityMode {
  COUNT
  WEIGHT
}

model ProductVariant {
  id           String       @id @default(uuid())
  productId    String
  sku          String
  barcode      String?
  price        Decimal      @db.Decimal(12, 2) // for WEIGHT variants, price per unit of quantity (e.g. per kg)
  quantityMode QuantityMode @default(COUNT)
  // Unit cost - optional (not every tenant tracks it), used only for the
  // COGS/margin report. Null cost means that report just omits margin for
  // this variant rather than treating cost as zero (a zero cost would
  // silently overstate margin).
  cost         Decimal?     @db.Decimal(12, 2)
  // School suppliers: whether this option is on the price list schools order from, and the price schools pay (null = the normal price).
  onSchoolList Boolean      @default(false)
  schoolPrice  Decimal?     @db.Decimal(12, 2)
  // What this size/option is called to people ("Large loaf 800g"). Optional: without it the product code is all there is to tell
  // options apart. Shown with the product name in the shop, on the till and in orders.
  name         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  product                Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItems         InventoryItem[]
  batches                Batch[]
  inventoryTransactions  InventoryTransaction[]
  saleLineItems          SaleLineItem[]
  stockTransfers         StockTransfer[]
  stockTakeLines         StockTakeLine[]
  lowStockAlerts         LowStockAlert[]
  layawayLineItems       LayawayLineItem[]
  kitchenTicketLines     KitchenTicketLine[]
  purchaseOrderLineItems PurchaseOrderLineItem[]
  goodsReceiptLines      GoodsReceiptLine[]
  etimsItem              EtimsItem?
  schoolQuoteLines       SchoolQuoteLine[]
  schoolTenderLines      SchoolTenderLine[]
  repackagedFrom         Repackaging[]            @relation("RepackagingFrom")
  repackagedInto         Repackaging[]            @relation("RepackagingTo")
  recipeIngredients      RecipeIngredient[]       @relation("RecipeFor")
  restaurantDish         RestaurantDish?
  restaurantTabLines     RestaurantTabLine[]
  hotelRoomType          HotelRoomType?
  usedAsIngredientIn     RecipeIngredient[]       @relation("RecipeIngredientOf")
  ingredientOfSaleLines  SaleLineItemIngredient[]
  wasteLogs              WasteLog[]
  ingredientOfWaste      WasteIngredient[]
  productionOrders       ProductionOrder[]
  onlineOrderLines       OnlineOrderLine[]

  @@unique([productId, sku])
  @@index([barcode])
  schoolOrderLines   SchoolOrderLine[]
  supplierInvoiceLines SupplierInvoiceLine[]

  @@map("product_variants")
}

// A restaurant (or any processor) makes a sellable item out of raw
// materials rather than reselling something it bought as-is - a Chicken
// Biryani isn't received from a supplier, it's assembled from rice,
// chicken, and oil at cook time. Optional per DESIGN.md discussion: a
// ProductVariant with zero RecipeIngredient rows behaves exactly as it
// always has (its own stock is received and decremented directly - the
// right model for a resold-as-is item like a bottled drink); a variant
// WITH rows here instead has each ingredient's stock decremented on sale
// (see SalesService), and never carries its own InventoryItem - nothing
// ever "receives" a finished dish. Quantity is consumed per 1 unit of the
// parent variant sold, e.g. 0.2 (kg) rice per 1 Biryani.
model RecipeIngredient {
  id                  String   @id @default(uuid())
  variantId           String // the sellable dish
  ingredientVariantId String // the raw material consumed
  quantity            Decimal  @db.Decimal(14, 3)
  createdAt           DateTime @default(now())

  variant           ProductVariant @relation("RecipeFor", fields: [variantId], references: [id], onDelete: Cascade)
  ingredientVariant ProductVariant @relation("RecipeIngredientOf", fields: [ingredientVariantId], references: [id], onDelete: Restrict)

  @@unique([variantId, ingredientVariantId])
  @@index([variantId])
  @@map("recipe_ingredients")
}

// A snapshot of exactly what a recipe-tracked sale line actually consumed,
// taken at sale time (see SalesService) - NOT a live re-derivation from
// RecipeIngredient, because a recipe can change (a substituted ingredient,
// an adjusted portion size) after the sale happened. Voiding a sale
// reverses these rows, not whatever the recipe says today - the same
// "snapshot what was actually agreed/consumed, don't trust it to still
// match the current catalog" principle as SaleLineItem.unitPrice/taxAmount.
model SaleLineItemIngredient {
  id                  String  @id @default(uuid())
  saleLineItemId      String
  ingredientVariantId String
  quantity            Decimal @db.Decimal(14, 3)

  saleLineItem      SaleLineItem   @relation(fields: [saleLineItemId], references: [id], onDelete: Cascade)
  ingredientVariant ProductVariant @relation(fields: [ingredientVariantId], references: [id], onDelete: Restrict)

  @@index([saleLineItemId])
  @@map("sale_line_item_ingredients")
}

// ─────────────────────────────────────────────────────────────────────────
// Inventory — append-only ledger is the source of truth (DESIGN.md §4).
// InventoryItem.quantity is derived/maintained from InventoryTransaction
// rows, never written to directly by application code outside that
// maintenance path.
// ─────────────────────────────────────────────────────────────────────────

model InventoryItem {
  id                String   @id @default(uuid())
  branchId          String
  variantId         String
  quantity          Decimal  @default(0) @db.Decimal(14, 3) // derived - see note above
  lowStockThreshold Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt         DateTime @updatedAt

  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([branchId, variantId])
  @@map("inventory_items")
}

enum LowStockAlertStatus {
  OPEN
  RESOLVED
}

// Detected synchronously whenever InventoryTransactionsService.recordInTx
// moves a branch+variant's quantity across its lowStockThreshold (see that
// service) - no polling/cron needed since every quantity change already
// goes through one place. There is at most one OPEN alert per
// branch+variant at a time (re-crossing below the threshold while already
// OPEN does not create a duplicate); it auto-resolves the moment the
// quantity rises back above the threshold. This is the durable record a
// future SMS/notification worker (DESIGN.md Phase 2 roadmap - deferred
// until Redis/BullMQ and Africa's Talking credentials are provisioned)
// would consume, same pattern as how sale_payments already models M-Pesa
// fields ahead of the integration being wired up.
model LowStockAlert {
  id             String              @id @default(uuid())
  organizationId String
  branchId       String
  variantId      String
  quantity       Decimal             @db.Decimal(14, 3) // snapshot at the moment the alert opened
  threshold      Decimal             @db.Decimal(14, 3) // snapshot of InventoryItem.lowStockThreshold at that moment
  status         LowStockAlertStatus @default(OPEN)
  createdAt      DateTime            @default(now())
  resolvedAt     DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([branchId, variantId, status])
  @@map("low_stock_alerts")
}

enum InventoryTxnType {
  SALE
  /// Goods delivered by a supplier (a goods-received note). Kept apart from ADJUSTMENT, which is a correction.
  RECEIPT
  TRANSFER
  ADJUSTMENT
  STOCKTAKE
  RETURN
  REPACK
  WASTE
  PRODUCTION
  // Stock committed to an accepted online order (OnlineOrdersService) -
  // separate from SALE so reports can tell counter and web sales apart.
  ONLINE_SALE
  // Goods delivered to a school on credit (a school supplier's delivery note and invoice) - kept apart from SALE so the till and
  // the credit business can be told apart.
  CREDIT_SALE
}

model InventoryTransaction {
  id            String           @id @default(uuid())
  branchId      String
  variantId     String
  batchId       String?
  type          InventoryTxnType
  quantityDelta Decimal          @db.Decimal(14, 3) // signed
  referenceId   String? // sale_id / transfer_id / stocktake_id, loosely typed by design
  // What was paid per unit, on a delivery received with a price (the product's cost is then updated as a weighted average).
  unitCost      Decimal?         @db.Decimal(12, 2)
  createdAt     DateTime         @default(now())

  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  batch   Batch?         @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([branchId, variantId])
  @@map("inventory_transactions")
}

// Batch/expiry tracking — a core capability (perishable retail stock needs
// it too), not pharmacy-exclusive. The pharmacy module adds *enforcement*
// (block sale of an expired/controlled batch) on top of this core table.
model Batch {
  id               String    @id @default(uuid())
  variantId        String
  batchNumber      String
  expiryDate       DateTime?
  quantityReceived Decimal   @db.Decimal(14, 3)
  createdAt        DateTime  @default(now())

  variant               ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  inventoryTransactions InventoryTransaction[]
  saleLineItems         SaleLineItem[]
  wasteLogs             WasteLog[]

  @@index([variantId])
  @@map("batches")
}

// A single-step transfer between two branches of the same organization -
// no in-transit/receiving workflow (nothing in the design calls for one at
// pilot scale), so it completes atomically: one TRANSFER-type
// InventoryTransaction (negative) at fromBranch, one (positive) at
// toBranch, both referencing this row's id, written in the same
// transaction as this record (see StockTransfersService).
model StockTransfer {
  id             String   @id @default(uuid())
  organizationId String
  fromBranchId   String
  toBranchId     String
  variantId      String
  quantity       Decimal  @db.Decimal(14, 3)
  notes          String?
  createdById    String
  // Client-generated idempotency key - same nullable+unique pattern as
  // Refund.clientId (existing rows predate this column; every new
  // transfer's DTO requires one). A retried submission returns the
  // original transfer instead of moving stock twice.
  clientId       String?  @unique
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromBranch   Branch         @relation("TransferFromBranch", fields: [fromBranchId], references: [id])
  toBranch     Branch         @relation("TransferToBranch", fields: [toBranchId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  createdBy    OrgUser        @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@map("stock_transfers")
}

// Breaking bulk stock into smaller resale units - buying a 20L jerrycan of
// cooking oil or a 50kg bag of rice and selling it off in Ksh 30-50
// scoops/portions is the normal shape of a Kenyan duka, not an edge case,
// so this is a first-class stock operation rather than a manual pair of
// adjustments. Always at a single branch (repackaging happens where the
// physical stock is), and always atomic: one REPACK InventoryTransaction
// decrementing the bulk variant, one REPACK InventoryTransaction
// incrementing the portioned variant, both referencing this row's id, all
// in the same transaction (see RepackagingService) - same shape as
// StockTransfer above, just within one branch instead of across two.
model Repackaging {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String
  fromVariantId  String // the bulk item consumed
  fromQuantity   Decimal  @db.Decimal(14, 3) // how many bulk units were broken down
  toVariantId    String // the resale-sized item produced
  toQuantity     Decimal  @db.Decimal(14, 3) // total resale units produced (the yield)
  notes          String?
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch         @relation(fields: [branchId], references: [id])
  fromVariant  ProductVariant @relation("RepackagingFrom", fields: [fromVariantId], references: [id])
  toVariant    ProductVariant @relation("RepackagingTo", fields: [toVariantId], references: [id])
  createdBy    OrgUser        @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@map("repackagings")
}

// ─────────────────────────────────────────────────────────────────────────
// Manufacturing — raw materials transformed into finished goods for sale
// (bakery, brick-making...). A ProductionOrder generalizes Repackaging's
// 1-in/1-out shape to an N-ingredient BOM: the finished good's
// RecipeIngredient rows (already built for recipe-tracked sales, see
// RecipeIngredient above) double as the bill of materials here - no
// separate BOM table. Completing an order decrements every ingredient by
// (recipe quantity × actualQuantity) and increments the finished good by
// actualQuantity, both legs tagged PRODUCTION and referencing this row's
// id, in one transaction (see ProductionOrdersService) - same atomicity
// guarantee as Repackaging, just N ingredients instead of 1.
enum ProductionOrderStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id              String                @id @default(uuid())
  organizationId  String
  branchId        String
  variantId       String // the finished good being produced
  plannedQuantity Decimal               @db.Decimal(14, 3)
  actualQuantity  Decimal?              @db.Decimal(14, 3) // set on completion - the real yield, which can differ from planned
  status          ProductionOrderStatus @default(DRAFT)
  notes           String?
  createdById     String
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime              @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch         @relation(fields: [branchId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  createdBy    OrgUser        @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@map("production_orders")
}

enum WasteReason {
  EXPIRED
  DAMAGED
  SPOILED
  OVERPRODUCTION
  OTHER
}

// Disposing of stale/spoiled stock - or, for a recipe-tracked dish (see
// RecipeIngredient), of made-but-unsold food - as its own tracked reason,
// not a generic ADJUSTMENT indistinguishable from a stock-count
// correction. variantId is always the item that was actually thrown away
// (the raw material, or the finished dish); for a recipe-tracked variant
// nothing of its own was ever in stock, so WasteService instead decrements
// each ingredient (via WasteIngredient, the same snapshot-at-the-time
// shape as SaleLineItemIngredient) and this row's cost fields still
// reflect what was actually lost.
//
// unitCost/totalCost are snapshotted at write-off time (current
// ProductVariant.cost, or the summed current cost of a recipe's
// ingredients) - null when cost isn't known, same "don't fake a zero"
// rule as everywhere else costs are optional in this schema - so the
// waste report can total actual loss without a later cost change
// silently rewriting history.
model WasteLog {
  id             String      @id @default(uuid())
  organizationId String
  branchId       String
  variantId      String
  quantity       Decimal     @db.Decimal(14, 3)
  reason         WasteReason
  notes          String?
  // Which specific batch was written off - only meaningful for a plain
  // stocked item (a recipe-tracked variant has no batches of its own).
  batchId        String?
  unitCost       Decimal?    @db.Decimal(12, 2)
  totalCost      Decimal?    @db.Decimal(12, 2)
  createdById    String
  createdAt      DateTime    @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id])
  variant      ProductVariant    @relation(fields: [variantId], references: [id])
  batch        Batch?            @relation(fields: [batchId], references: [id])
  createdBy    OrgUser           @relation(fields: [createdById], references: [id])
  ingredients  WasteIngredient[]

  @@index([organizationId])
  @@index([branchId])
  @@index([variantId])
  @@map("waste_logs")
}

model WasteIngredient {
  id                  String  @id @default(uuid())
  wasteLogId          String
  ingredientVariantId String
  quantity            Decimal @db.Decimal(14, 3)

  wasteLog          WasteLog       @relation(fields: [wasteLogId], references: [id], onDelete: Cascade)
  ingredientVariant ProductVariant @relation(fields: [ingredientVariantId], references: [id], onDelete: Restrict)

  @@index([wasteLogId])
  @@map("waste_ingredients")
}

enum StockTakeStatus {
  OPEN
  COMPLETED
}

// A physical stock count for a branch. Opening one snapshots the current
// system quantity for every variant with stock at that branch (so a count
// taken over several hours isn't compared against a moving target); each
// line is then filled in with what was actually counted, and completing
// the stock take reconciles any variance into the inventory ledger as
// ADJUSTMENT transactions - never a silent overwrite of InventoryItem.
model StockTake {
  id             String          @id @default(uuid())
  organizationId String
  branchId       String
  status         StockTakeStatus @default(OPEN)
  startedById    String
  completedAt    DateTime?
  createdAt      DateTime        @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  startedBy    OrgUser         @relation(fields: [startedById], references: [id])
  lines        StockTakeLine[]

  @@index([organizationId])
  @@index([branchId])
  @@map("stock_takes")
}

model StockTakeLine {
  id              String   @id @default(uuid())
  stockTakeId     String
  variantId       String
  systemQuantity  Decimal  @db.Decimal(14, 3)
  countedQuantity Decimal? @db.Decimal(14, 3)
  variance        Decimal? @db.Decimal(14, 3)

  stockTake StockTake      @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([stockTakeId, variantId])
  @@index([stockTakeId])
  @@map("stock_take_lines")
}

// ─────────────────────────────────────────────────────────────────────────
// Shifts / cash reconciliation
// ─────────────────────────────────────────────────────────────────────────

model Shift {
  id           String    @id @default(uuid())
  branchId     String
  terminalId   String
  openedById   String
  openingFloat Decimal   @default(0) @db.Decimal(12, 2)
  countedCash  Decimal?  @db.Decimal(12, 2)
  variance     Decimal?  @db.Decimal(12, 2)
  openedAt     DateTime  @default(now())
  closedAt     DateTime?

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  terminal Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  openedBy OrgUser  @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  sales    Sale[]

  @@index([branchId])
  @@index([terminalId])
  @@map("shifts")
}

// ─────────────────────────────────────────────────────────────────────────
// Sales
// ─────────────────────────────────────────────────────────────────────────

enum SaleStatus {
  PENDING_SYNC
  COMPLETED
  VOIDED
}

// A tenant's repeat customer, tracked for loyalty points. Attaching a
// customer to a sale is always optional - most POS sales are anonymous
// walk-ins - so every FK to Customer is nullable.
model Customer {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  // Not globally unique (a customer might share a phone or have none on
  // file), but unique per-org so lookup-by-phone at the register is
  // unambiguous within a tenant.
  phone          String?
  loyaltyPoints  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales             Sale[]
  layaways          Layaway[]
  salonAppointments SalonAppointment[]
  serviceJobs       ServiceJob[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@map("customers")
}

model Sale {
  id                String     @id @default(uuid())
  organizationId    String
  branchId          String
  terminalId        String
  shiftId           String?
  cashierSessionId  String
  customerId        String?
  // Client-generated UUID from the offline terminal - the idempotency key
  // for sync replay (DESIGN.md §6). Distinct from `id` so the server is
  // free to also assign its own id without colliding with client state.
  clientId          String     @unique
  status            SaleStatus @default(PENDING_SYNC)
  total             Decimal    @db.Decimal(12, 2)
  // Loyalty points earned/redeemed on this specific sale - denormalized
  // onto the sale (rather than only mutating Customer.loyaltyPoints) so
  // the sale receipt/history can always show what happened on that ticket
  // even after the customer's running balance has since moved on.
  pointsEarned      Int        @default(0)
  pointsRedeemed    Int        @default(0)
  priceDriftFlagged Boolean    @default(false)
  createdAt         DateTime   @default(now())

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  terminal         Terminal       @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  shift            Shift?         @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  cashierSession   CashierSession @relation(fields: [cashierSessionId], references: [id])
  cashier          OrgUser?       @relation("SaleCashier", fields: [cashierOrgUserId], references: [id])
  cashierOrgUserId String?
  customer         Customer?      @relation(fields: [customerId], references: [id])

  lineItems            SaleLineItem[]
  payments             SalePayment[]
  discounts            Discount[]
  refunds              Refund[]
  restaurantTable      RestaurantSaleTable?
  restaurantTip        RestaurantSaleTip?
  kitchenTickets       KitchenTicket[]
  tabSale              RestaurantTabSale?
  roomSettlement       RoomBooking?
  folioEntries         HotelFolioEntry[]
  pharmacyPrescription PharmacySalePrescription?
  salonAppointmentSale SalonAppointmentSale?
  serviceJobSale       ServiceJobSale?
  onlineOrder          OnlineOrder?

  @@index([organizationId])
  @@index([branchId])
  @@map("sales")
}

model SaleLineItem {
  id        String  @id @default(uuid())
  saleId    String
  variantId String
  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  taxAmount Decimal @default(0) @db.Decimal(12, 2)
  // Which batch this line was drawn from - core capability (see Batch's
  // comment), nullable since most sales don't track batches at all.
  // Denormalized onto the line item itself (not just implied via the
  // InventoryTransaction ledger) so a sale's own receipt/history can show
  // which batch/expiry a dispensed item came from without a join through
  // the ledger.
  batchId   String?

  sale        Sale                     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant     ProductVariant           @relation(fields: [variantId], references: [id])
  batch       Batch?                   @relation(fields: [batchId], references: [id])
  ingredients SaleLineItemIngredient[]

  @@index([saleId])
  @@map("sale_line_items")
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
  WALLET
  ROOM_CHARGE // put on a checked-in hotel guest's folio (the sale is recorded; the guest pays at check-out)
  MPESA_RECEIPT // paid by M-Pesa to the business's own till/paybill, receipt code typed in (taken on trust, like card)
  ACCOUNT // goods delivered on credit and invoiced (a school supplier's sale): the money comes later, as a receipt on the school's account
}

model SalePayment {
  id                 String        @id @default(uuid())
  saleId             String
  method             PaymentMethod
  amount             Decimal       @db.Decimal(12, 2) // in org.baseCurrency
  // Unique: one provider transaction (e.g. an M-Pesa checkoutRequestId)
  // settles at most one sale. Nulls (cash) don't collide in Postgres.
  providerReference  String?       @unique
  // M-Pesa always settles in KES regardless of org.baseCurrency - see
  // DESIGN.md §9. Both null for cash/card-in-base-currency payments.
  settlementCurrency String?
  settlementAmount   Decimal?      @db.Decimal(12, 2)
  createdAt          DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_payments")
}

enum StkRequestStatus {
  PENDING
  SUCCESS
  FAILED
}

// A tracked Daraja STK push, independent of Sale - a sale is only created
// (via the normal /sales endpoint, SalePaymentInputDto.providerReference
// pointing back at this row's checkoutRequestId) once Safaricom's async
// callback confirms SUCCESS. Never held open inside SalesService.create's
// own transaction, since the customer approving the prompt on their phone
// can take anywhere from seconds to (if they don't respond) never.
model MpesaStkRequest {
  id                 String           @id @default(uuid())
  organizationId     String
  checkoutRequestId  String           @unique
  // The clientId the terminal will use for the eventual /sales POST -
  // lets the callback (and a supervisor debugging a stuck payment) trace
  // an STK request back to the sale it's for before that sale exists.
  reference          String
  amount             Decimal          @db.Decimal(12, 2)
  phoneNumber        String
  status             StkRequestStatus @default(PENDING)
  mpesaReceiptNumber String?
  resultDesc         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("mpesa_stk_requests")
}

enum DiscountType {
  PERCENT
  FIXED
}

model Discount {
  id           String       @id @default(uuid())
  saleId       String
  type         DiscountType
  value        Decimal      @db.Decimal(12, 2)
  approvedById String

  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  approvedBy OrgUser @relation("DiscountApprovedBy", fields: [approvedById], references: [id])

  @@index([saleId])
  @@map("discounts")
}

// Money the business spent that is not stock: rent, power, wages, transport, airtime... Recorded by hand (owner/manager) and
// subtracted from the gross profit in the profit report. Buying stock is NOT an expense here - it reaches the report as the
// cost of what was sold - so recording both would count it twice.
model Expense {
  id             String   @id @default(uuid())
  organizationId String
  // Which branch it was for; null = the whole business (it is then left out of a single branch's profit).
  branchId       String?
  // The day the money was spent (a calendar date, Nairobi time) - not when it was typed in.
  spentOn        DateTime @db.Date
  // One of EXPENSE_CATEGORIES (apps/api/src/expenses/expense-categories.ts); a string so categories can grow without a migration.
  category       String
  description    String?
  amount         Decimal  @db.Decimal(12, 2)
  // CASH | MPESA | BANK | CARD, informational.
  paidWith       String?
  recordedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([organizationId, spentOn])
  @@map("expenses")
}

model Refund {
  id           String   @id @default(uuid())
  saleId       String
  amount       Decimal  @db.Decimal(12, 2)
  reason       String
  approvedById String
  // Client-generated idempotency key (nullable+unique - see Sale.clientId's
  // comment for the general pattern; nullable here only because existing
  // rows predate this column, every new refund's DTO requires one). A
  // retried refund submission (e.g. a terminal that never saw the response
  // to a request that actually succeeded) returns the original refund
  // instead of erroring or double-refunding.
  clientId     String?  @unique
  createdAt    DateTime @default(now())

  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  approvedBy OrgUser @relation("RefundApprovedBy", fields: [approvedById], references: [id])

  @@index([saleId])
  @@map("refunds")
}

// ─────────────────────────────────────────────────────────────────────────
// Layaway - a customer reserves items and pays them off over time before
// pickup. Deliberately does NOT hold/reserve inventory at creation (that
// would need a new inventory-transaction type just to represent a
// non-committal hold, and this pilot's stock-conflict philosophy is
// already "never block, reconcile after the fact" - DESIGN.md §6). Stock
// is only actually decremented at completion/pickup, via the same
// InventoryTransactionsService.recordInTx used by sales.
// ─────────────────────────────────────────────────────────────────────────

enum LayawayStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model Layaway {
  id             String        @id @default(uuid())
  organizationId String
  branchId       String
  customerId     String
  status         LayawayStatus @default(OPEN)
  total          Decimal       @db.Decimal(12, 2)
  depositPaid    Decimal       @default(0) @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  completedAt    DateTime?
  cancelledAt    DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer          @relation(fields: [customerId], references: [id])
  lineItems    LayawayLineItem[]
  payments     LayawayPayment[]

  @@index([organizationId])
  @@index([branchId])
  @@map("layaways")
}

model LayawayLineItem {
  id        String  @id @default(uuid())
  layawayId String
  variantId String
  quantity  Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  taxAmount Decimal @default(0) @db.Decimal(12, 2)

  layaway Layaway        @relation(fields: [layawayId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([layawayId])
  @@map("layaway_line_items")
}

model LayawayPayment {
  id        String        @id @default(uuid())
  layawayId String
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  createdAt DateTime      @default(now())

  layaway Layaway @relation(fields: [layawayId], references: [id], onDelete: Cascade)

  @@index([layawayId])
  @@map("layaway_payments")
}

// ─────────────────────────────────────────────────────────────────────────
// Offline sync (DESIGN.md §6)
// ─────────────────────────────────────────────────────────────────────────

enum SyncStatus {
  PENDING
  APPLIED
  FAILED
}

model SyncOutbox {
  id         String     @id @default(uuid())
  terminalId String
  eventType  String
  payload    Json
  // The idempotency key - matches the client-generated id on the record the
  // event creates/mutates (e.g. Sale.clientId). Replays are safe no-ops.
  clientId   String     @unique
  status     SyncStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  appliedAt  DateTime?

  terminal Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  @@index([terminalId, status])
  @@map("sync_outbox")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit log — append-only. Nothing in this table is ever updated/deleted by
// application code.
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  terminalId     String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        OrgUser?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────────────────────────────
// Restaurant vertical module (Phase 4, packages/modules/restaurant) —
// entityExtensions/transactionExtensions per DESIGN.md §3.
//
// A genuine limitation of this stack worth stating plainly rather than
// glossing over: Prisma has no supported way to split one database's
// schema across multiple independently-migrated schema.prisma files, so
// a vertical module's own tables still have to be declared in this one
// shared file even though the module's *code* (services, controllers,
// the manifest) lives entirely under packages/modules/restaurant and is
// never imported by core. "Zero changes to core packages" (DESIGN.md's
// Phase 4 success criterion) means zero changes to core's TypeScript
// business logic - SalesService, InventoryTransactionsService, etc. were
// not touched to add this vertical, only extended via the emit() calls
// already wired for the module contract in general, not for restaurant
// specifically. The schema file is shared infrastructure every module
// extends into, the same way every module shares one Postgres instance.
// ─────────────────────────────────────────────────────────────────────────

enum RestaurantTableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  NEEDS_CLEANING
}

model RestaurantTable {
  id             String                @id @default(uuid())
  organizationId String
  branchId       String
  label          String // e.g. "Table 4", "Patio 2" - free text, not a seat map (out of scope for this slice)
  seats          Int
  status         RestaurantTableStatus @default(AVAILABLE)
  /// Set instead of deleting a table that has history (tabs, sales); it then drops off the floor.
  archivedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  saleLinks    RestaurantSaleTable[]
  onlineOrders OnlineOrder[]
  reservations TableReservation[]
  tabs         RestaurantTab[]

  @@unique([branchId, label])
  @@index([organizationId])
  @@map("restaurant_tables")
}

// The transactionExtensions pattern from DESIGN.md §3: a dedicated 1:1
// extension table linking a core Sale to a module-owned entity, rather
// than a JSONB blob on Sale itself or (worse) a nullable tableId column
// added directly to the core sales table. Core's Sale model was not
// touched to add this - the restaurant module's own controller creates
// this row itself, in the same request that calls core's
// SalesService.create(), immediately after the sale is returned.
model RestaurantSaleTable {
  id      String @id @default(uuid())
  saleId  String @unique
  tableId String

  sale  Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  table RestaurantTable @relation(fields: [tableId], references: [id])

  @@map("restaurant_sale_tables")
}

// Also transactionExtensions, same reasoning as RestaurantSaleTable.
// Deliberately NOT folded into Sale.total/SalePayment: core's total is
// the amount owed for goods+tax and is what loyalty points are earned
// on (SalesService.create()'s LOYALTY_EARN_RATE math) and what shift
// cash-reconciliation sums (ShiftsService) - mixing tip money into it
// would silently inflate both. A tip/service charge is tracked here as
// parallel revenue the restaurant module reports on independently,
// collected as extra cash alongside the sale's own exact-total payment
// rather than folded into SalePayment.amount.
model RestaurantSaleTip {
  id                  String   @id @default(uuid())
  saleId              String   @unique
  tipAmount           Decimal  @default(0) @db.Decimal(12, 2)
  serviceChargeAmount Decimal  @default(0) @db.Decimal(12, 2)
  createdAt           DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("restaurant_sale_tips")
}

// Order-to-KDS routing + course timing. A station is a physical/logical
// kitchen prep area ("Grill", "Bar", "Cold") - entityExtensions, a new
// first-class entity this module owns outright.
model KitchenStation {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String
  name           String
  /// Set instead of deleting a station that has history; its dishes then go to the first station.
  archivedAt     DateTime?
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tickets      KitchenTicket[]
  dishes       RestaurantDish[]
  tabLines     RestaurantTabLine[]

  @@unique([branchId, name])
  @@index([organizationId])
  @@map("kitchen_stations")
}

// ─────────────────────────────────────────────────────────────────────────
// Hotel rooms (a restaurant business that also lets rooms). A room TYPE is a kind of room with a nightly price and a
// number of identical rooms; availability is counted per night from the bookings, so the hotel assigns the actual
// room at check-in. Guests book on the marketplace with no account and pay a deposit by M-Pesa to the hotel's own
// shop payment account; the balance is settled at the hotel.
// ─────────────────────────────────────────────────────────────────────────
model HotelRoomType {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  /// Comma-separated, e.g. "WiFi, Breakfast included, Hot shower".
  amenities      String?
  pricePerNight  Decimal  @db.Decimal(12, 2)
  maxGuests      Int      @default(2)
  /// How many identical rooms of this type the hotel has.
  quantity       Int      @default(1)
  /// The deposit taken online, as a percent of the whole stay (the rest is paid at the hotel).
  depositPercent Int      @default(30)
  /// Advertised on the marketplace's Hotels page.
  isListed       Boolean  @default(false)
  isActive       Boolean  @default(true)
  /// The product ("Room: Deluxe") room nights are sold as when a stay is settled, so room revenue is in Sales, Reports and tax.
  variantId      String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variant      ProductVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  photos       HotelRoomPhoto[]
  bookings     RoomBooking[]
  rooms        HotelRoom[]
  rateCard     HotelRateCard?
  seasons      HotelSeason[]
  mealPrices   HotelMealPrice[]

  @@index([organizationId])
  @@map("hotel_room_types")
}

model HotelRoomPhoto {
  id         String   @id @default(uuid())
  roomTypeId String
  /// Object key in the Blob store: orgs/<organizationId>/rooms/<roomTypeId>/<uuid>.<ext>
  storageKey String   @unique
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  roomType HotelRoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId])
  @@map("hotel_room_photos")
}

enum RoomBookingStatus {
  PENDING_PAYMENT // created, M-Pesa deposit prompt sent
  CONFIRMED // deposit paid - the rooms are held for the guest
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  EXPIRED // the deposit was never paid in time
  NO_SHOW
}

model RoomBooking {
  id             String            @id @default(uuid())
  organizationId String
  roomTypeId     String
  /// Short code the guest quotes at the front desk, e.g. "ZB-7K3Q9P".
  bookingNumber  String            @unique
  status         RoomBookingStatus @default(PENDING_PAYMENT)
  guestName      String
  guestPhone     String
  guestEmail     String?
  guests         Int
  rooms          Int               @default(1)
  checkIn        DateTime          @db.Date
  checkOut       DateTime          @db.Date
  nights         Int
  notes          String?
  // Snapshots, so the booking reads the same after the hotel renames or reprices a room.
  hotelName      String
  /// Null for a booking made at the front desk or by phone (no marketplace shop involved).
  hotelSlug      String?
  roomTypeName   String
  pricePerNight  Decimal           @db.Decimal(12, 2)
  total          Decimal           @db.Decimal(12, 2)
  /// What is paid online now; the balance (total - deposit) is paid at the hotel.
  depositAmount  Int
  commissionRate Decimal           @db.Decimal(5, 4)
  /// Recorded when the guest checks out: rate x the room price for the whole stay (NOT the deposit, which the hotel chooses),
  /// then rolled into the hotel's monthly commission invoice.
  commissionAmount Decimal?        @db.Decimal(12, 2)
  /// Set when this booking's commission is rolled into a monthly invoice - a booking can only ever be billed once.
  commissionInvoiceId String?

  paymentPhone          String?
  paymentDeadline       DateTime?
  tumaMerchantRequestId String?
  paymentAttemptedAt    DateTime?
  mpesaReceiptNumber    String?   @unique
  paidAt                DateTime?
  lastPaymentError      String?
  // No account behind a booking: the guest's browser holds a secret and only its hash is kept.
  guestTokenHash        String?

  /// Who is staying: adults and children (the price can depend on it). Older bookings only know `guests`.
  adults          Int?
  children        Int               @default(0)
  mealPlan        MealPlan          @default(ROOM_ONLY)
  /// The guest-register entry this stay belongs to (a returning guest has one entry and many stays).
  guestId         String?
  /// The guest asked not to be texted (confirmation, reminder, thank-you).
  smsOptOut       Boolean           @default(false)
  /// How a stay's price was made up (nights, rates, extras) - for the folio and for explaining a change.
  priceBreakdown  Json?
  /// What the hotel kept of the deposit when the booking was cancelled (its cancellation policy).
  cancelFeeKept   Decimal?          @db.Decimal(12, 2)

  /// Where the booking came from. Commission is only ever charged on MARKETPLACE bookings.
  source          RoomBookingSource @default(MARKETPLACE)
  idNumber        String?
  nationality     String?
  /// Set when someone other than the nightly price was agreed (Manager or Owner only; audit-logged).
  rateOverriddenBy String?
  earlyCheckInBy  String?
  /// Why a stay was checked out with money still owing (Manager or Owner).
  balanceLeftReason String?
  createdById     String?
  /// The core sale that recorded the room revenue when the stay was settled at check-out.
  settlementSaleId String? @unique

  checkedInAt  DateTime?
  checkedOutAt DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roomType          HotelRoomType      @relation(fields: [roomTypeId], references: [id])
  commissionInvoice CommissionInvoice? @relation(fields: [commissionInvoiceId], references: [id])
  settlementSale    Sale?              @relation(fields: [settlementSaleId], references: [id])
  guest             HotelGuest?        @relation(fields: [guestId], references: [id], onDelete: SetNull)
  notifications     HotelNotification[]
  folio             HotelFolio?
  assignments       HotelRoomAssignment[]

  @@index([organizationId, status])
  @@index([roomTypeId, checkIn, checkOut])
  @@index([commissionInvoiceId])
  @@index([guestId])
  @@map("room_bookings")
}

enum RoomBookingSource {
  MARKETPLACE
  FRONT_DESK
  PHONE
}

enum HotelRoomStatus {
  VACANT_CLEAN
  VACANT_DIRTY
  OCCUPIED
  OUT_OF_ORDER
}

enum FolioEntryType {
  ROOM_NIGHT
  CHARGE
  PAYMENT
  REFUND
  ADJUSTMENT
}

/// A real room ("101"). A room TYPE's quantity follows the number of active rooms of that type once it has any.
model HotelRoom {
  id             String          @id @default(uuid())
  organizationId String
  branchId       String
  roomTypeId     String
  number         String
  floor          String?
  status         HotelRoomStatus @default(VACANT_CLEAN)
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roomType     HotelRoomType         @relation(fields: [roomTypeId], references: [id])
  assignments  HotelRoomAssignment[]

  @@unique([branchId, number])
  @@index([organizationId])
  @@index([roomTypeId])
  @@map("hotel_rooms")
}

/// Which room(s) a stay is in. A room move closes one row and opens another, so the history is kept.
model HotelRoomAssignment {
  id        String    @id @default(uuid())
  bookingId String
  roomId    String
  fromAt    DateTime  @default(now())
  /// Null while the guest is in the room.
  toAt      DateTime?
  movedBy   String?
  reason    String?

  booking RoomBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room    HotelRoom   @relation(fields: [roomId], references: [id])

  @@index([bookingId])
  @@index([roomId])
  @@map("hotel_room_assignments")
}

enum MealPlan {
  ROOM_ONLY
  BED_BREAKFAST
  HALF_BOARD
  FULL_BOARD
}

enum HotelNotificationKind {
  CONFIRMATION
  REMINDER
  THANK_YOU
  CANCELLATION
  AMENDMENT
}

/// A guest's running account for a stay. Entries are only ever added; a correction is a new ADJUSTMENT by a manager.
model HotelFolio {
  id             String   @id @default(uuid())
  organizationId String
  bookingId      String   @unique
  /// Set when the nights of the stay were posted (at check-in), so they are posted exactly once.
  nightsPostedAt DateTime?
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      RoomBooking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  entries      HotelFolioEntry[]

  @@index([organizationId])
  @@map("hotel_folios")
}

model HotelFolioEntry {
  id          String         @id @default(uuid())
  folioId     String
  type        FolioEntryType
  /// Always positive, except an ADJUSTMENT, which is signed (negative = a discount). A PAYMENT reduces what the guest owes;
  /// everything else adds to it.
  amount      Decimal        @db.Decimal(12, 2)
  /// The tax inside a ROOM_NIGHT's amount, shown separately on the folio.
  taxAmount   Decimal        @default(0) @db.Decimal(12, 2)
  /// That tax split by name ({ "VAT": 800, "Tourism levy": 100 }), when the hotel has set several.
  taxBreakdown Json?
  description String
  /// The night a ROOM_NIGHT is for.
  nightDate   DateTime?      @db.Date
  /// How a PAYMENT or REFUND was made, and its receipt/slip number.
  method      PaymentMethod?
  reference   String?
  /// The sale a CHARGE came from, or the settlement sale of the room nights.
  saleId      String?
  shiftId     String?
  createdById String
  createdAt   DateTime       @default(now())

  folio HotelFolio @relation(fields: [folioId], references: [id], onDelete: Cascade)
  sale  Sale?      @relation(fields: [saleId], references: [id])

  @@index([folioId])
  @@index([saleId])
  @@map("hotel_folio_entries")
}

/// A hotel's own rules, one row per business: its cancellation policy, when the night audit runs, which messages it sends.
model HotelSetting {
  id                   String   @id @default(uuid())
  organizationId       String   @unique
  /// A booking cancelled at least this many days before arrival gets its deposit back in full.
  cancelFreeDays       Int      @default(2)
  /// Cancelled later than that, the hotel keeps this percent of the deposit (0 until the hotel sets a policy, so nothing changes for it).
  cancelKeepPercent    Int      @default(0)
  /// The night audit runs by itself at this hour (Kenya time) for the day that has just ended.
  nightAuditHour       Int      @default(3)
  /// An unpaid arrival is marked a no-show by the night audit once this hour of the arrival day has passed.
  noShowCutoffHour     Int      @default(18)
  confirmationSms      Boolean  @default(true)
  reminderSms          Boolean  @default(true)
  thankYouSms          Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("hotel_settings")
}

/// A tax or levy on room nights, as a percent the business sets (VAT 16, tourism levy 2...). They are added on top of the room price.
model HotelTax {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  percent        Decimal  @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("hotel_taxes")
}

/// How a room type is priced beyond its base price per night: a weekend price, what an extra adult or child costs.
model HotelRateCard {
  id             String   @id @default(uuid())
  organizationId String
  roomTypeId     String   @unique
  /// Price per night on weekend nights; empty = the base price.
  weekendRate    Decimal? @db.Decimal(12, 2)
  /// Which nights are weekend nights (0 = Sunday ... 6 = Saturday). Usually Friday and Saturday.
  weekendDays    Int[]    @default([5, 6])
  /// Adults included in the price of one room; more than that pay the extra adult rate.
  includedAdults Int      @default(2)
  /// Children per room who stay free; more than that pay the extra child rate.
  freeChildren   Int      @default(0)
  extraAdultRate Decimal  @default(0) @db.Decimal(12, 2)
  extraChildRate Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roomType     HotelRoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("hotel_rate_cards")
}

/// A date range with its own price for a room type (high season, festive season...). Both ends are included.
model HotelSeason {
  id             String   @id @default(uuid())
  organizationId String
  roomTypeId     String
  name           String
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  rate           Decimal  @db.Decimal(12, 2)
  weekendRate    Decimal? @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roomType     HotelRoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([roomTypeId, startDate, endDate])
  @@map("hotel_seasons")
}

/// What a meal plan adds per person per night for a room type (Room only is free).
model HotelMealPrice {
  id             String   @id @default(uuid())
  organizationId String
  roomTypeId     String
  plan           MealPlan
  adultPrice     Decimal  @default(0) @db.Decimal(12, 2)
  childPrice     Decimal  @default(0) @db.Decimal(12, 2)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roomType     HotelRoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, plan])
  @@index([organizationId])
  @@map("hotel_meal_prices")
}

/// The guest register: a person who has stayed (or is booked). One entry however many stays; found again by phone or ID.
model HotelGuest {
  id             String   @id @default(uuid())
  organizationId String
  fullName       String
  phone          String
  email          String?
  /// The ID or passport number is kept encrypted; the last four digits and a lookup hash are kept beside it.
  idNumberEnc    String?
  idLast4        String?
  idHash         String?
  nationality    String?
  address        String?
  vehicleReg     String?
  smsOptOut      Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     RoomBooking[]

  @@unique([organizationId, idHash])
  @@index([organizationId, phone])
  @@map("hotel_guests")
}

/// The close of a hotel day. One per business per day, so running it twice never doubles anything.
model HotelNightAudit {
  id             String   @id @default(uuid())
  organizationId String
  auditDate      DateTime @db.Date
  /// "auto" when the timer ran it, otherwise the OrgUser who pressed the button.
  ranBy          String
  summary        Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, auditDate])
  @@map("hotel_night_audits")
}

/// Which messages were sent (or skipped) for a booking, so none is sent twice.
model HotelNotification {
  id             String                @id @default(uuid())
  organizationId String
  bookingId      String
  kind           HotelNotificationKind
  /// SENT, SKIPPED (opted out, no number, switched off) or FAILED
  status         String
  detail         String?
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      RoomBooking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, kind])
  @@index([organizationId])
  @@map("hotel_notifications")
}

// Which kitchen station prepares a dish. A till order picks the station per line; an order from a table QR code
// has nobody to pick, so each dish remembers its station here (a dish with no row goes to the branch's first station).
model RestaurantDish {
  id             String   @id @default(uuid())
  organizationId String
  variantId      String   @unique
  stationId      String
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  station      KitchenStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("restaurant_dishes")
}

enum TableReservationStatus {
  REQUESTED // the guest asked; the restaurant has not answered yet
  CONFIRMED
  DECLINED
  CANCELLED // cancelled by the guest or the restaurant
  SEATED
  NO_SHOW
}

// A guest's request for a table at a given date and time. No payment: the restaurant confirms or declines (and the
// guest is texted). A table can be assigned on confirming, so the floor view can show who is expected where.
model TableReservation {
  id                String                 @id @default(uuid())
  organizationId    String
  /// The branch the shop serves from (a reservation is for that branch's floor).
  branchId          String
  /// Set when the restaurant confirms with a particular table.
  tableId           String?
  /// Short code the guest quotes, e.g. "ZT-7K3Q9P".
  reservationNumber String                 @unique
  status            TableReservationStatus @default(REQUESTED)
  guestName         String
  guestPhone        String
  partySize         Int
  date              DateTime               @db.Date
  /// 24-hour local time, "19:30".
  time              String
  notes             String?
  /// What the restaurant told the guest when it confirmed or declined.
  restaurantNote    String?
  shopName          String
  shopSlug          String
  /// No account behind a reservation: the guest's browser holds a secret and only its hash is kept.
  guestTokenHash    String
  confirmedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  table        RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([organizationId, date])
  @@index([organizationId, status])
  @@map("table_reservations")
}

enum KitchenTicketStatus {
  HELD // course not fired yet - not visible on the KDS screen
  QUEUED // fired, waiting for the kitchen to start it
  IN_PROGRESS
  READY
  SERVED
}

// One ticket per (sale, station, course) - a table's order is split
// across however many stations its items route to, so "the kitchen"
// sees one focused ticket per prep area rather than a single ticket
// listing items three different stations need to independently track.
model KitchenTicket {
  id           String              @id @default(uuid())
  /// Set for a ticket from a one-off table sale. A ticket from an open tab has no sale (a tab can end in several), only a tabId.
  saleId       String?
  tabId        String?
  stationId    String
  courseNumber Int                 @default(1)
  status       KitchenTicketStatus @default(QUEUED)
  firedAt      DateTime?
  startedAt    DateTime?
  readyAt      DateTime?
  servedAt     DateTime?
  createdAt    DateTime            @default(now())

  sale    Sale?               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  tab     RestaurantTab?      @relation(fields: [tabId], references: [id])
  station KitchenStation      @relation(fields: [stationId], references: [id])
  lines   KitchenTicketLine[]

  @@index([stationId, status])
  @@index([tabId])
  @@map("kitchen_tickets")
}

model KitchenTicketLine {
  id        String  @id @default(uuid())
  ticketId  String
  variantId String
  quantity  Int
  notes     String?
  /// A line voided from an open tab stays on the ticket, struck through, so the kitchen knows to stop.
  voidedAt  DateTime?

  ticket  KitchenTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([ticketId])
  @@map("kitchen_ticket_lines")
}

enum RestaurantTabStatus {
  OPEN
  CLOSED
  VOID
}

enum RestaurantTabLineStatus {
  ORDERED
  PAID // settled by a sale (a tab can be paid in parts)
  VOIDED
}

/// A running bill for a table: items are added (and sent to the kitchen) as the diners order, and paid at the end.
/// One OPEN tab per table at a time (a partial unique index in the migration enforces it).
model RestaurantTab {
  id             String              @id @default(uuid())
  organizationId String
  branchId       String
  tableId        String
  status         RestaurantTabStatus @default(OPEN)
  openedBy       String // the OrgUser who opened it
  openedAt       DateTime            @default(now())
  closedAt       DateTime?
  /// The sale that paid it when one sale paid all of it; a split bill has several (see RestaurantTabSale).
  saleId         String?
  guestCount     Int                 @default(1)
  notes          String?
  voidReason     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table        RestaurantTable      @relation(fields: [tableId], references: [id])
  lines        RestaurantTabLine[]
  tabSales     RestaurantTabSale[]
  tickets      KitchenTicket[]

  @@index([organizationId, status])
  @@index([tableId])
  @@map("restaurant_tabs")
}

model RestaurantTabLine {
  id                  String                  @id @default(uuid())
  tabId               String
  variantId           String
  quantity            Decimal                 @db.Decimal(14, 3)
  /// The price when it was ordered (the bill is worked out from today's price, as the sale is - this is the record).
  unitPrice           Decimal                 @db.Decimal(12, 2)
  stationId           String
  courseNumber        Int                     @default(1)
  notes               String?
  status              RestaurantTabLineStatus @default(ORDERED)
  voidReason          String?
  voidedById          String?
  voidedAt            DateTime?
  addedById           String
  kitchenTicketId     String?
  kitchenTicketLineId String?
  /// While a payer's sale is being made, the lines it covers are claimed with its clientId, so two tills cannot both
  /// charge them. A claim older than two minutes with no sale behind it is ignored.
  claimClientId       String?
  claimedAt           DateTime?
  saleId              String?
  createdAt           DateTime                @default(now())

  tab     RestaurantTab  @relation(fields: [tabId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])
  station KitchenStation @relation(fields: [stationId], references: [id])

  @@index([tabId])
  @@map("restaurant_tab_lines")
}

/// Which sales paid a tab, and who each was for (a split bill has one per payer).
model RestaurantTabSale {
  id        String   @id @default(uuid())
  tabId     String
  saleId    String   @unique
  label     String?
  createdAt DateTime @default(now())

  tab  RestaurantTab @relation(fields: [tabId], references: [id], onDelete: Cascade)
  sale Sale          @relation(fields: [saleId], references: [id])

  @@index([tabId])
  @@map("restaurant_tab_sales")
}

/// Per-branch restaurant settings. reserveLeadMinutes: a confirmed reservation shows its table as Reserved from this
/// long before the time.
model RestaurantSetting {
  id                 String   @id @default(uuid())
  organizationId     String
  branchId           String   @unique
  reserveLeadMinutes Int      @default(60)
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("restaurant_settings")
}

// ─────────────────────────────────────────────────────────────────────────
// Pharmacy vertical module (Phase 5, apps/api/src/pharmacy) — batch/expiry
// enforcement (already built) plus these two: controlled-substance flags
// and prescription linkage.
//
// Unlike Batch (explicitly core - see that model's comment), whether a
// product is a controlled substance is pharmacy-specific policy, not
// something core's catalog needs to know about - kept as a pharmacy-owned
// extension table (entityExtensions per DESIGN.md §3) rather than a
// column added to core's Product model.
// ─────────────────────────────────────────────────────────────────────────

model PharmacyProductFlag {
  id                    String   @id @default(uuid())
  productId             String   @unique
  isControlledSubstance Boolean  @default(false)
  // Free-text classification (e.g. a Schedule/class designation) - not an
  // enum, since these vary by jurisdiction and this pilot doesn't need to
  // encode any particular regulatory scheme's exact categories.
  schedule              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("pharmacy_product_flags")
}

// transactionExtensions pattern, same as RestaurantSaleTable/
// RestaurantSaleTip: a dedicated 1:1 link rather than JSONB on Sale or a
// column added to it. Deliberately created by PharmacySalesService as the
// direct caller of SalesService.create() (POST /pharmacy/sales), not via
// an afterComplete hook - Phase 4's restaurant work already found and
// documented why a hook can't see extension data its own caller hasn't
// written yet, so a controlled-substance sale's prescription requirement
// is validated BEFORE core is ever called, not after the fact.
model PharmacySalePrescription {
  id                 String   @id @default(uuid())
  saleId             String   @unique
  prescriptionNumber String
  prescriberName     String
  issuedDate         DateTime
  createdAt          DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("pharmacy_sale_prescriptions")
}

// ─────────────────────────────────────────────────────────────────────────
// Salon vertical module (Phase 5+, apps/api/src/salon) — appointment/
// resource scheduling, DESIGN.md's remaining Phase 5+ vertical.
//
// Deliberately no transactionExtensions/hooks into core in this first
// slice - unlike restaurant/pharmacy, booking an appointment doesn't need
// to touch SalesService at all. Linking a completed appointment to a
// checkout sale (the same "module calls into core" pattern proven twice
// already) is a natural follow-up slice, not folded into this one.
// ─────────────────────────────────────────────────────────────────────────

model SalonResource {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String
  // e.g. "Stylist: Jane", "Chair 2" - a resource is whatever the branch
  // actually needs to schedule against (a person, a chair, a room), not
  // modeled as separate staff/room entities since a pilot-scale salon's
  // real constraint is usually "how many of X can we book at once."
  name           String
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  appointments SalonAppointment[]

  @@unique([branchId, name])
  @@index([organizationId])
  @@map("salon_resources")
}

enum SalonAppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model SalonAppointment {
  id             String                 @id @default(uuid())
  organizationId String
  branchId       String
  resourceId     String
  customerId     String?
  // Free text for this slice ("Haircut", "Manicure") rather than linked
  // to a core Product - a real service-catalog integration (with
  // pricing feeding into a checkout sale) is exactly the kind of
  // follow-up slice noted above, not needed for scheduling itself to be
  // useful on its own.
  serviceName    String
  startTime      DateTime
  endTime        DateTime
  status         SalonAppointmentStatus @default(SCHEDULED)
  notes          String?
  // Client-generated idempotency key - same nullable+unique pattern as
  // Refund.clientId/StockTransfer.clientId (existing rows predate this
  // column). Both the staff-facing create() and the public booking flow
  // require one going forward: without it, a retried submission after a
  // dropped response hits assertNoOverlap's double-booking check and
  // errors outright instead of returning the original booking.
  clientId       String?                @unique
  // A random, unguessable value generated at creation the same way `id`
  // above already is (@default(uuid())) - the only "credential" a
  // public, unauthenticated customer has to view/cancel their own
  // booking later (public-booking module). Never returned by any
  // staff-facing endpoint - staff already reach any appointment through
  // their own authenticated session, they don't need this. Not a
  // password (nothing to remember/type) - a capability token embedded in
  // a link, the same shape as an unsubscribe link or a password-reset
  // link elsewhere on the web.
  cancelToken    String                 @unique @default(uuid())
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  resource     SalonResource         @relation(fields: [resourceId], references: [id])
  customer     Customer?             @relation(fields: [customerId], references: [id])
  sale         SalonAppointmentSale?

  @@index([resourceId, startTime])
  @@index([organizationId])
  @@map("salon_appointments")
}

// transactionExtensions pattern, same as RestaurantSaleTable/
// PharmacySalePrescription: a dedicated 1:1 link between a core Sale and
// this module's own entity, created by SalonAppointmentsService as the
// direct caller of SalesService.create() (POST
// /salon/appointments/:id/checkout), not via a hook - the same reasoning
// already documented twice: a hook can't see extension data its own
// caller hasn't written yet, and can't retroactively undo a sale that
// already committed. Core's line items still reference real
// ProductVariants (checkout needs an actual catalog price to charge),
// unlike SalonAppointment.serviceName which stays free text - a deeper
// service-catalog integration is a further follow-up, not this slice.
model SalonAppointmentSale {
  id            String @id @default(uuid())
  appointmentId String @unique
  saleId        String @unique

  appointment SalonAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("salon_appointment_sales")
}

// ─────────────────────────────────────────────────────────────────────────
// Service industry — job/work-order businesses that bill labor and parts
// against a customer's asset (garage: a vehicle; transport: a route/run).
// `assetLabel` stays free text (plate number, route name...) the same way
// SalonAppointment.serviceName does, rather than a dedicated Vehicle model
// - keeps this generic across very different service businesses. No
// line-item table of its own: invoicing reuses core's SaleLineItemInputDto
// directly (parts AND labor are both just catalog ProductVariants - a
// "Labor" service item priced per hour, quantity = hours billed), the
// exact same "module composes a checkout sale from core's DTO" pattern as
// SalonAppointmentSalesService/CheckoutAppointmentDto.
enum ServiceJobStatus {
  OPEN
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
  CANCELLED
}

model ServiceJob {
  id             String           @id @default(uuid())
  organizationId String
  branchId       String
  customerId     String?
  assetLabel     String? // e.g. a vehicle plate or a transport route/run reference
  description    String
  status         ServiceJobStatus @default(OPEN)
  notes          String?
  createdById    String
  closedAt       DateTime?
  createdAt      DateTime         @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch          @relation(fields: [branchId], references: [id])
  customer     Customer?       @relation(fields: [customerId], references: [id])
  createdBy    OrgUser         @relation(fields: [createdById], references: [id])
  sale         ServiceJobSale?

  @@index([organizationId])
  @@index([branchId])
  @@map("service_jobs")
}

model ServiceJobSale {
  id     String @id @default(uuid())
  jobId  String @unique
  saleId String @unique

  job  ServiceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sale Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("service_job_sales")
}

// ─────────────────────────────────────────────────────────────────────────
// Purchasing — suppliers and the purchase orders raised against them.
// Receiving stock ad-hoc (no PO) still goes through Batch/InventoryTransaction
// directly (see BatchesService) - a PurchaseOrder is the optional paper
// trail of "what did we expect to arrive, from whom, and how much of it
// actually has" on top of that same receiving path, not a replacement path.

model Supplier {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  notes          String?
  /// Days after a bill's date that it falls due (30 unless set).
  paymentTermsDays Int    @default(30)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  bills          SupplierBill[]

  @@index([organizationId])
  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  organizationId String
  branchId       String // receiving branch
  supplierId     String
  status         PurchaseOrderStatus @default(DRAFT)
  reference      String? // supplier's own invoice/PO number, free text
  notes          String?
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier     Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    OrgUser                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lineItems    PurchaseOrderLineItem[]
  receipts     GoodsReceipt[]
  bills        SupplierBill[]

  @@index([organizationId])
  @@index([branchId])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderLineItem {
  id               String   @id @default(uuid())
  purchaseOrderId  String
  variantId        String
  quantityOrdered  Decimal  @db.Decimal(14, 3)
  // Denormalized running total, updated every time a receipt is recorded
  // against this line - the same "derived value maintained alongside the
  // append-only ledger" shape as InventoryItem.quantity (see its comment):
  // the ledger entry (InventoryTransaction, referenceId = this PO's id) is
  // the source of truth, this column is just the fast-read total.
  quantityReceived Decimal  @default(0) @db.Decimal(14, 3)
  unitCost         Decimal? @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([variantId])
  @@map("purchase_order_line_items")
}

// ─────────────────────────────────────────────────────────────────────────
// Platform admin — genuinely cross-tenant, not owned by any Organization.
// No RLS policy in rls.sql for either table below, deliberately: RLS
// exists to isolate tenant data from OTHER tenants, and neither of these
// tables is tenant data in the first place. Isolating them from
// tenant-facing requests is instead enforced at the application layer -
// PlatformAdminAuthGuard is the only thing that can ever authenticate a
// request against these tables (see platform-admin/ module), and no
// tenant-facing controller ever queries them.

model PlatformAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLog PlatformAuditLog[]

  @@map("platform_admins")
}

// A platform admin can see across every tenant - a materially more
// sensitive capability than anything an OrgUser has, so every action
// (including reads, unlike the tenant-scoped AuditLog which only logs
// writes) gets a row here, not just mutations.
model PlatformAuditLog {
  id              String   @id @default(uuid())
  platformAdminId String
  action          String
  entityType      String
  entityId        String?
  organizationId  String? // informational only - not an FK, since the referenced org may later be deleted and this log should outlive it
  createdAt       DateTime @default(now())

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId])
  @@map("platform_audit_log")
}

// ─────────────────────────────────────────────────────────────────────────
// Platform billing (rental subscriptions) - the platform owner's own
// business, not tenant data. Only PlatformAdminController (guarded by
// PlatformAdminAuthGuard, a completely different identity from a tenant
// JWT) ever queries these. plans has no RLS (a global price list);
// subscriptions/subscription_payments carry a policy that leaves
// platform admin's no-tenant queries unrestricted but confines any
// tenant-scoped transaction to its own rows - see rls.sql's "platform
// billing tables" comment.

model Plan {
  id                String   @id @default(uuid())
  // "BASIC" | "STANDARD" | "PREMIUM" - a string, not an enum, so a new
  // tier doesn't need a migration (same reasoning as Organization.industryType).
  tier              String   @unique
  name              String
  priceKes          Decimal  @db.Decimal(12, 2)
  billingPeriodDays Int      @default(30)
  maxDevices        Int
  maxBranches       Int
  // Retiring a plan without deleting it - existing subscriptions on a
  // retired plan keep working, it just can't be assigned to a new tenant.
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                String   @id @default(uuid())
  // One subscription per tenant at this pilot's scale - a plan change is
  // an update to this row (with a SubscriptionPayment audit trail of when
  // and what changed), not a new row.
  organizationId    String   @unique
  planId            String
  currentPeriodEnd  DateTime
  graceDays         Int      @default(7)
  // True until the first real payment is recorded - lets the platform
  // admin dashboard distinguish "never paid, still on trial" from "paying
  // customer currently in their grace window" instead of both just
  // looking like ACTIVE/GRACE from currentPeriodEnd alone.
  isTrial           Boolean  @default(true)
  // Force-suspend independent of payment status (e.g. abuse, tenant
  // requested pause) - reactivation clears this, it never rewrites
  // currentPeriodEnd. Effective status (TRIAL/ACTIVE/GRACE/SUSPENDED) is
  // computed from this + currentPeriodEnd + graceDays at read time
  // (PlatformAdminService), not stored redundantly - see ShiftReport for
  // the same computed-not-stored pattern elsewhere in this schema.
  manuallySuspended Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan                  @relation(fields: [planId], references: [id])
  payments     SubscriptionPayment[]

  @@map("subscriptions")
}

model SubscriptionPayment {
  id                        String   @id @default(uuid())
  subscriptionId            String
  amount                    Decimal  @db.Decimal(12, 2)
  method                    String // "MPESA" | "BANK" | "CASH" - recorded manually by a platform admin, not yet a live Daraja/bank integration (same deferral as the tenant-facing M-Pesa STK push had before credentials existed).
  reference                 String?
  // The billing period this payment extends currentPeriodEnd to cover -
  // informational for the payment-history view, not re-derived from it.
  periodEnd                 DateTime
  recordedByPlatformAdminId String?
  paidAt                    DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_payments")
}

// Online shop add-on (marketplace Phase 1) - a tenant's public storefront
// settings, one row per organization. Two groups of fields with different
// owners:
// - addonActive / commissionRate are set ONLY by a platform admin
//   (PlatformAdminService.setOnlineStoreAddon) - the add-on is a paid
//   extra, so a tenant must never be able to switch it on for itself.
//   OnlineStoreService's tenant-facing update deliberately has no DTO
//   field for either.
// - Everything else is the tenant's own shop configuration.
// The shop is publicly visible only when BOTH addonActive (platform says
// it's paid for) and isPublished (tenant says it's ready) are true - the
// platform switching the add-on off hides the shop without erasing the
// tenant's settings, so switching it back on restores it as it was.
//
// Buyers pay the business directly through the business's OWN TUMA
// (tuma.co.ke) merchant account - Zaroda never holds buyer money, it
// bills commission monthly instead. The TUMA API key is stored encrypted
// (common/crypto/secret-box.ts) and is never returned by any endpoint.
model OnlineStore {
  id                           String   @id @default(uuid())
  organizationId               String   @unique
  addonActive                  Boolean  @default(false)
  // Fraction, e.g. 0.0300 = 3%. Null = the platform default
  // (DEFAULT_COMMISSION_RATE in online-store.constants.ts) - a per-tenant
  // override for a negotiated rate, not a copy of the default.
  commissionRate               Decimal? @db.Decimal(5, 4)
  isPublished                  Boolean  @default(false)
  /// Set by ZARODA to take this business's hotel rooms off the marketplace (complaints, abuse). Existing bookings are untouched;
  /// while set the hotel cannot list rooms or take new bookings.
  hotelBlockedReason           String?
  hotelBlockedAt               DateTime?
  /// Set by ZARODA to switch off ordering from table QR codes for this business. Orders already placed are untouched.
  tableOrderingBlockedReason   String?
  tableOrderingBlockedAt       DateTime?
  /// The restaurant takes table reservation requests from the marketplace (it opts in).
  reservationsEnabled          Boolean  @default(false)
  // The business's own shop link, e.g. /s/mama-mboga. Globally unique
  // across tenants - enforced by this index, since RLS hides every other
  // tenant's row from an application-level pre-check.
  slug                         String?  @unique
  displayName                  String?
  description                  String?
  contactPhone                 String?
  // Which branch's stock online orders are sold from and where pickup
  // happens. SetNull if that branch is deleted - OnlineStoreService then
  // treats the shop as not ready (see isReadyToPublish).
  fulfilmentBranchId           String?
  pickupEnabled                Boolean  @default(true)
  deliveryEnabled              Boolean  @default(false)
  /// Counties this shop delivers to. Empty = just the county of its fulfilment branch. Pickup, hotel and rental bookings are never limited by distance.
  deliveryCounties             String[] @default([])
  tumaEmail                    String?
  tumaApiKeyEncrypted          String?
  // How buyers' payments reach the business: 'TUMA' (above) or 'DARAJA' - the
  // business's OWN Safaricom Daraja app, collecting straight into its own
  // Paybill or Till (the same choice school tenants have). One is active at a
  // time; the other's details may stay saved so the business can switch back.
  paymentGateway               String   @default("TUMA")
  mpesaAccountType             String? // 'PAYBILL' | 'TILL'
  // The shortcode Daraja signs with: the Paybill number, or for a Till the
  // store (head office) number. A Till's own number goes in mpesaTillNumber.
  mpesaShortcode               String?
  mpesaTillNumber              String?
  mpesaConsumerKeyEncrypted    String?
  mpesaConsumerSecretEncrypted String?
  mpesaPasskeyEncrypted        String?
  mpesaEnvironment             String   @default("production")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fulfilmentBranch Branch?      @relation(fields: [fulfilmentBranchId], references: [id], onDelete: SetNull)

  @@index([fulfilmentBranchId])
  @@map("online_stores")
}

// Product photos for the online shop. The file itself lives in object
// storage (Cloudflare R2 / any S3-compatible bucket - see
// common/storage/object-storage.service.ts); this row records where.
// Uploaded browser -> bucket directly via a short-lived presigned URL, then
// confirmed with the API (ProductImagesService), so large files never pass
// through the API process. Lowest sortOrder is the cover photo.
model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  // Object key in the bucket, always under
  // orgs/<organizationId>/products/<productId>/ - ProductImagesService
  // refuses to confirm a key outside that prefix, so one tenant can't
  // attach another tenant's upload.
  storageKey String   @unique
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

// ── Online Shop buyers and orders ─────────────────────────────────────────

// A member of the public who shops online. Deliberately NOT tenant-scoped
// (same reasoning as `users`): one buyer shops at many businesses with one
// login. Identified by phone (verified with an SMS code - BuyerOtp), since
// that's also how they pay (M-Pesa).
model Buyer {
  id        String   @id @default(uuid())
  // A shopper signs in with an EMAIL code (the default - free, no SMS needed) or an SMS code
  // to their phone, so either may be what created the account. Lowercased.
  email     String?  @unique
  // Normalized 2547XXXXXXXX / 2541XXXXXXXX - see normalizeKenyanPhone(). Set by an SMS sign-in,
  // or remembered from the M-Pesa number given at checkout.
  phone     String?  @unique
  name      String?
  // Phone + PIN sign-in, which works on every network (texts only reach some numbers). Only a salted hash is kept.
  pinHash        String?
  pinFailCount   Int       @default(0)
  pinLockedUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders OnlineOrder[]

  @@map("buyers")
}

// One-time SMS login codes. Only a hash of the code is stored; codes
// expire after a few minutes and lock after too many wrong attempts
// (BuyerAuthService). Not tenant-scoped - a login happens before any
// business is involved.
model BuyerOtp {
  id         String    @id @default(uuid())
  // "EMAIL" or "SMS".
  channel    String    @default("SMS")
  // The email address or normalized phone number the code was sent to.
  identifier String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, createdAt])
  @@map("buyer_otps")
}

enum OnlineOrderStatus {
  PENDING_PAYMENT // created, M-Pesa prompt sent, waiting for TUMA's callback
  PAID // buyer paid the business; waiting for the business to accept
  ACCEPTED // business accepted - stock deducted from the fulfilment branch
  READY // ready for pickup / out for delivery
  COMPLETED // collected / delivered - commission is now owed
  CANCELLED
  EXPIRED // never paid within the payment window
}

enum FulfilmentType {
  PICKUP
  DELIVERY
  DINE_IN // a diner at a restaurant table, ordering from the table's QR code (no sign-in)
}

// An order placed in one business's online shop. Tenant-owned (the
// business sees it) AND buyer-owned (the buyer sees it) - the RLS policy
// admits either app.current_tenant or app.current_buyer, see rls.sql.
//
// Buyers pay the business directly through the business's own TUMA
// account; Zaroda never holds the money. Commission is recorded on the
// order (commissionAmount, once COMPLETED) and billed monthly.
//
// Stock: available-to-sell = branch quantity minus quantities on
// PENDING_PAYMENT/PAID orders (held, not yet deducted). Accepting deducts
// the stock through the normal inventory ledger (ONLINE_SALE); cancelling
// an accepted order puts it back (RETURN).
model OnlineOrder {
  id                  String            @id @default(uuid())
  organizationId      String
  // Null for a diner ordering from a table QR code: they give a phone number, not an account.
  buyerId             String?
  // Fulfilment branch at the time of ordering - a later change to the
  // shop's setting doesn't move existing orders.
  branchId            String
  // Short human code for phone calls and SMS, e.g. "ZR-7K3Q9P".
  orderNumber         String            @unique
  status              OnlineOrderStatus @default(PENDING_PAYMENT)
  fulfilmentType      FulfilmentType
  deliveryAddress     String?
  // The county the order is delivered to (a delivery order is only accepted for a county the shop serves).
  deliveryCounty      String?
  // Table orders (DINE_IN): which table, with its label as it was when ordered.
  tableId             String?
  tableLabel          String?
  // Table orders have no account to prove who may look at them; the diner's browser holds a secret, and only its hash is kept.
  guestTokenHash      String?
  buyerNote           String?
  buyerName           String?
  buyerPhone          String
  // Snapshots, so a buyer's order history still reads correctly after
  // the business renames its shop - and so buyer-side queries never need
  // to read online_stores across tenants.
  shopName            String
  shopSlug            String
  subtotal            Decimal           @db.Decimal(12, 2)
  // M-Pesa only moves whole shillings - the subtotal rounded up. Shown to
  // the buyer before paying.
  amountDue           Int
  /// The convenience fee the shopper paid on top of the items (whole shillings; part of amountDue). The shop collects it and
  /// sends it to Zaroda at the end of the day - see CommissionInvoice kind DAILY_FEE. 0 on older orders and on table orders.
  convenienceFee      Int      @default(0)
  /// A tip the diner added (table orders). Already part of amountDue; kept apart because it is the staff's, so it earns no
  /// commission and is not part of the sale.
  tipAmount           Int               @default(0)
  commissionRate      Decimal           @db.Decimal(5, 4)
  commissionAmount    Decimal?          @db.Decimal(12, 2)
  // Set when this order's commission is rolled into a monthly invoice -
  // an order can only ever be billed once.
  commissionInvoiceId String?

  // Payment (TUMA STK push into the business's account)
  paymentPhone          String
  paymentDeadline       DateTime
  // Tuma's merchant request id for the most recent STK push - what its
  // /payment/status is asked about. Not unique: a retried payment replaces
  // it, and a late callback for an earlier prompt can still be checked
  // (OnlineOrdersService.handleTumaCallback).
  tumaMerchantRequestId String?
  paymentAttemptedAt    DateTime?
  mpesaReceiptNumber    String?   @unique
  paidAt                DateTime?
  lastPaymentError      String?

  stockCommitted Boolean   @default(false)
  // The ordinary till sale written when the order is accepted, so online
  // revenue shows in Sales, Reports and profit like any other sale.
  saleId         String?   @unique
  acceptedAt     DateTime?
  readyAt        DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  cancelledBy    String? // "BUYER" | "BUSINESS"
  cancelReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buyer             Buyer?             @relation(fields: [buyerId], references: [id])
  table             RestaurantTable?   @relation(fields: [tableId], references: [id], onDelete: SetNull)
  branch            Branch             @relation(fields: [branchId], references: [id])
  lines             OnlineOrderLine[]
  commissionInvoice CommissionInvoice? @relation(fields: [commissionInvoiceId], references: [id])
  sale              Sale?              @relation(fields: [saleId], references: [id], onDelete: SetNull)
  deliveryJobs      DeliveryJob[]

  @@index([organizationId, status])
  @@index([commissionInvoiceId])
  @@index([buyerId, createdAt])
  @@index([branchId, status])
  @@map("online_orders")
}

model OnlineOrderLine {
  id          String  @id @default(uuid())
  orderId     String
  variantId   String
  // Snapshots of what the buyer saw when ordering.
  productName String
  variantSku  String
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  /// What the buyer asked for on this dish ("no onions", "extra spicy") - shown on the kitchen ticket.
  note        String?

  order   OnlineOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
  @@map("online_order_lines")
}

// ── Online Shop commission billing ────────────────────────────────────────

enum CommissionInvoiceStatus {
  ISSUED // sent to the business, unpaid
  PAID
  WAIVED // written off by a platform admin
}

// Zaroda's commission on a business's COMPLETED online orders for one
// calendar month (Africa/Nairobi), billed after the month closes. Buyers
// pay the business directly, so this is invoiced rather than deducted -
// the business pays Zaroda the same way it pays its subscription, and a
// platform admin records it (PlatformAdminController). Tenant-scoped RLS:
// the business sees its own invoices; the platform admin reads across
// tenants the same per-tenant way it reads branches.
//
// An overdue ISSUED invoice hides the shop from buyers (not stored - worked
// out when a shop is viewed, see commission.util.ts isOverdue and
// ShopCatalogService.runForShop), like subscription status.
model CommissionInvoice {
  id                        String                  @id @default(uuid())
  organizationId            String
  invoiceNumber             String                  @unique
  /// MONTHLY = the old monthly commission; DAILY_FEE = the day's shopper convenience fees the shop collected and owes Zaroda.
  kind                      String                  @default("MONTHLY")
  // "2026-10" - one invoice per business per month.
  periodMonth               String
  periodStart               DateTime
  periodEnd                 DateTime
  orderCount                Int
  salesTotal                Decimal                 @db.Decimal(12, 2)
  commissionTotal           Decimal                 @db.Decimal(12, 2)
  // What the business pays online: the commission rounded UP to a whole
  // shilling (M-Pesa only moves whole shillings), set when issued.
  amountDue                 Int                     @default(0)
  status                    CommissionInvoiceStatus @default(ISSUED)
  issuedAt                  DateTime                @default(now())
  dueDate                   DateTime
  paidAt                    DateTime?
  paymentMethod             String? // "MPESA" | "BANK" | "CASH" - recorded manually, like SubscriptionPayment
  paymentReference          String?
  recordedByPlatformAdminId String?
  waivedReason              String?

  // Online payment through ZARODA's own Tuma account (like a school's
  // subscription): the latest STK push, and why the last attempt failed.
  tumaMerchantRequestId String?
  payPhone              String?
  payAttemptedAt        DateTime?
  lastPaymentError      String?

  // Automatic invoicing: when the invoice was emailed, and the furthest
  // reminder sent (0 none, 1 issued, 2 due soon, 3 overdue, 4 shop hidden)
  // - see commission.util.ts reminderStageFor. Keeps the daily run from
  // ever emailing the same notice twice.
  emailedAt     DateTime?
  reminderStage Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       OnlineOrder[]
  roomBookings RoomBooking[]

  @@unique([organizationId, periodMonth])
  @@index([organizationId, status])
  @@map("commission_invoices")
}

// ── Delivery riders ───────────────────────────────────────────────────────

enum VehicleType {
  BODA
  TUK_TUK
  VEHICLE
}

enum RiderStatus {
  PENDING // signed up, waiting for a Zaroda admin (shared pool only)
  APPROVED
  SUSPENDED
}

// A delivery rider. One identity per email. organizationId null = the shared
// pool (self-signed-up, approved by a platform admin); set = that business's own
// rider (added by the business, approved on creation, invisible to everyone else).
// Like buyers, riders sign in across businesses, so there is no row-level security
// here: every query is filtered by the verified rider id, the business, or runs
// as a platform admin (see rls.sql's "riders" comment).
model Rider {
  id             String       @id @default(uuid())
  // Optional: many riders have no email at all and sign in with their phone number and a PIN.
  email          String?      @unique
  fullName       String?
  phone          String?      @unique
  vehicleType    VehicleType?
  plateNumber    String?
  // Free text, e.g. "Milimani, Kisumu CBD" - where they usually work.
  area           String?
  status         RiderStatus  @default(PENDING)
  organizationId String?
  approvedAt     DateTime?
  lastLoginAt    DateTime?
  // Phone + PIN sign-in (works on every network; texts only reach some). Only a salted hash is kept.
  pinHash        String?
  pinFailCount   Int          @default(0)
  pinLockedUntil DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // The marketing team and member that onboarded this rider (see Organization.salesTeamId).
  salesTeamId  String?
  salesAgentId String?
  salesTeam    SalesTeam?  @relation(fields: [salesTeamId], references: [id], onDelete: SetNull)
  salesAgent   SalesAgent? @relation(fields: [salesAgentId], references: [id], onDelete: SetNull)

  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryJobs DeliveryJob[]
  quotes       DeliveryQuote[]

  @@index([organizationId])
  @@index([status])
  @@map("riders")
}

model RiderOtp {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@map("rider_otps")
}

// ── Delivery jobs ─────────────────────────────────────────────────────────

enum DeliveryJobStatus {
  OPEN // waiting for riders' quotes
  ASSIGNED // the buyer accepted a quote; the rider is on the way to collect
  PICKED_UP
  DELIVERED
  CANCELLED
  EXPIRED // nobody quoted (or the buyer didn't choose) before the deadline
}

// Who may see and quote on an open job.
enum DeliveryAudience {
  SHOP_RIDERS // only the business's own riders
  EVERYONE // the business's own riders and the shared pool
  ONE_RIDER // a single rider the business picked (targetRiderId)
}

enum DeliveryQuoteStatus {
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// One delivery of one online order. Riders work across businesses, so a job carries its own
// small snapshot of what a rider may see BEFORE being chosen (shop name, pickup place, the
// delivery area, item count). The buyer's name, phone and full address live in
// DeliveryJobContact, which only the business and the ONE assigned rider can read.
model DeliveryJob {
  id             String            @id @default(uuid())
  organizationId String
  orderId        String
  status         DeliveryJobStatus @default(OPEN)
  audience       DeliveryAudience
  targetRiderId  String?
  orderNumber    String
  shopName       String
  pickupArea     String
  dropoffSummary String
  itemCount      Int
  quoteDeadline  DateTime
  riderId        String?
  agreedFee      Int?
  assignedAt     DateTime?
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  // What the rider says they collected in cash from the buyer.
  cashCollected  Int?
  // Wrong delivery-code tries; after too many the rider is locked out and the shop settles it.
  codeAttempts   Int               @default(0)
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        OnlineOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider        Rider?              @relation(fields: [riderId], references: [id])
  quotes       DeliveryQuote[]
  contact      DeliveryJobContact?

  @@index([organizationId, status])
  @@index([orderId])
  @@index([status, quoteDeadline])
  @@index([riderId, status])
  @@map("delivery_jobs")
}

model DeliveryJobContact {
  jobId           String  @id
  organizationId  String
  buyerName       String?
  buyerPhone      String
  deliveryAddress String

  job          DeliveryJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("delivery_job_contacts")
}

// A rider's price for a job. One live quote per rider per job (they may change it while it is OFFERED).
model DeliveryQuote {
  id             String              @id @default(uuid())
  organizationId String
  jobId          String
  riderId        String
  // Whole shillings, paid to the rider in cash on delivery.
  fee            Int
  etaMinutes     Int?
  note           String?
  status         DeliveryQuoteStatus @default(OFFERED)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          DeliveryJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rider        Rider        @relation(fields: [riderId], references: [id])

  @@unique([jobId, riderId])
  @@index([jobId])
  @@index([riderId])
  @@map("delivery_quotes")
}

// ── Marketing teams ───────────────────────────────────────────────────────
// Teams of people who onboard businesses and riders across the country and are paid commission on
// what they generate. These are PLATFORM-level tables (no tenant): the platform owner manages the
// teams and their leaders; a leader manages their own team; a member sees only their own work.
// Access rules live in SalesTeamsService / SalesAgentService (like riders), not in row-level
// security, and both tables are on rls-coverage.spec.ts's exclusion list.

enum SalesAgentRole {
  LEADER
  MEMBER
}

enum SalesAgentStatus {
  ACTIVE
  SUSPENDED
}

enum SalesTeamStatus {
  ACTIVE
  PAUSED
}

model SalesTeam {
  id                    String          @id @default(uuid())
  name                  String          @unique
  region                String?
  status                SalesTeamStatus @default(ACTIVE)
  // The earning terms, as fractions (0.2500 = 25%); defaults are the spec's, all editable per team.
  // - memberShareRate: of the online-order commission Zaroda collects from a shop, to the member who signed it.
  // - subscriptionShareRate: of each monthly subscription the shop pays, to the same member.
  // - earningMonths: how long after the shop's sign-up the member (and leader) keep earning on it.
  // - leaderOverrideRate: of Zaroda's commission + subscriptions from ALL the team's shops, to the leader.
  //   Paid by Zaroda on top, never deducted from the member.
  // - onboardingBonusKes: once per shop, when it pays its SECOND monthly subscription.
  // - payoutCapRate: the most of Zaroda's revenue from one shop in one month that member + leader can earn together.
  // A change only affects what is earned after it: each earning row stores the rate it was worked out on.
  memberShareRate       Decimal         @default(0.25) @db.Decimal(5, 4)
  subscriptionShareRate Decimal         @default(0.10) @db.Decimal(5, 4)
  earningMonths         Int             @default(12)
  leaderOverrideRate    Decimal         @default(0.05) @db.Decimal(5, 4)
  onboardingBonusKes    Decimal         @default(500) @db.Decimal(12, 2)
  payoutCapRate         Decimal         @default(0.35) @db.Decimal(5, 4)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  agents        SalesAgent[]
  organizations Organization[]
  riders        Rider[]
  earnings      SalesEarning[]

  @@map("sales_teams")
}

model SalesAgent {
  id                 String           @id @default(uuid())
  teamId             String
  role               SalesAgentRole
  fullName           String
  // Stored lower-case; the sign-in username.
  email              String           @unique
  phone              String?
  passwordHash       String
  // True until the person has replaced the temporary password they were given.
  mustChangePassword Boolean          @default(true)
  status             SalesAgentStatus @default(ACTIVE)
  lastLoginAt        DateTime?
  // Where this person is paid: "MPESA_B2C" (account = their M-Pesa number) or "TUMA". Null = paid manually.
  payoutGateway      String?
  payoutAccount      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  team          SalesTeam      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  organizations Organization[]
  riders        Rider[]
  earnings      SalesEarning[]
  payouts       SalesPayout[]

  @@index([teamId])
  @@map("sales_agents")
}

// ── What the teams earn ───────────────────────────────────────────────────
// An append-only ledger: one row per thing earned, with the rate and base it was worked out on (so a later
// change to a team's terms never rewrites what was already earned). Kinds, each from one source:
//   COMMISSION_SHARE    a member's share of the commission Zaroda collected from a shop they signed;
//                       source = the PAID commission invoice.
//   SUBSCRIPTION_SHARE  a member's share of a monthly subscription the shop paid; source = that payment.
//   LEADER_OVERRIDE     the team leader's slice of the same commission or subscription, from every shop in the team.
//   ONBOARDING_BONUS    a flat amount to the member, once per shop, when it pays its second monthly subscription.
//   ADJUSTMENT          a negative row reversing part of an earlier one (a refund after it accrued).
// Only money Zaroda has actually received earns anything. (kind, sourceId) is unique, so however many
// times accrual runs, a source is credited once. A source that must never pay (shop suspended or unpaid at
// the time, member no longer active) is recorded as a VOID row, so a later reinstatement cannot back-pay it.
// Status: PENDING until the hold period after the month ends, then PAYABLE, then PAID (set when a payout
// is queued; a failed payout puts its earnings back to PAYABLE). ACCRUED is the old pre-hold status, no longer written.
// Platform-level, like the other sales_* tables: access rules live in SalesEarningsService.

enum SalesEarningKind {
  COMMISSION_SHARE
  LEADER_OVERRIDE
  ONBOARDING_BONUS
  SUBSCRIPTION_SHARE
  ADJUSTMENT
}

enum SalesEarningStatus {
  ACCRUED
  PAID
  PENDING
  PAYABLE
  VOID
}

enum SalesPayoutStatus {
  QUEUED
  PAID
  FAILED
}

model SalesEarning {
  id               String             @id @default(uuid())
  teamId           String
  agentId          String
  organizationId   String
  organizationName String
  kind             SalesEarningKind
  sourceId         String
  // The commission / subscription collected (for a bonus, the bonus amount), and the rate applied to it.
  baseKes          Decimal            @db.Decimal(12, 2)
  rate             Decimal?           @db.Decimal(5, 4)
  amountKes        Decimal            @db.Decimal(12, 2)
  // True when the payout cap shrank this row; note says why a VOID row never pays, or why an adjustment was made.
  capped           Boolean            @default(false)
  note             String?
  // When Zaroda received the money, and that moment's month in Nairobi ("2026-10").
  earnedAt         DateTime
  periodMonth      String
  status           SalesEarningStatus @default(PENDING)
  payoutId         String?
  createdAt        DateTime           @default(now())

  team   SalesTeam    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  agent  SalesAgent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  payout SalesPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@unique([kind, sourceId])
  @@index([agentId, status])
  @@index([teamId, periodMonth])
  @@index([organizationId, periodMonth])
  @@map("sales_earnings")
}

// Money Zaroda pays a person against what they earned, through M-Pesa B2C, TUMA, or recorded by hand.
// amountKes is the gross; taxWithheldKes is held back at payout, so they receive amountKes - taxWithheldKes.
model SalesPayout {
  id                        String            @id @default(uuid())
  agentId                   String
  amountKes                 Decimal           @db.Decimal(12, 2)
  taxWithheldKes            Decimal           @default(0) @db.Decimal(12, 2)
  // Covers everything earned up to and including this month ("2026-10").
  throughMonth              String
  method                    String // gateway: "MPESA_B2C" | "TUMA" | "MANUAL" (older rows: "MPESA" | "BANK" | "CASH")
  reference                 String?
  status                    SalesPayoutStatus @default(PAID)
  // The gateway's id for the request, to match its result callback; why it failed.
  gatewayRequestId          String?
  failureReason             String?
  recordedByPlatformAdminId String?
  paidAt                    DateTime?
  createdAt                 DateTime          @default(now())

  agent    SalesAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  earnings SalesEarning[]

  @@index([agentId])
  @@index([gatewayRequestId])
  @@map("sales_payouts")
}

// One row ("default"): how and when the platform pays teams. Platform-level, like the other sales_* tables.
model SalesPayoutSettings {
  id                 String   @id @default("default")
  // "MANUAL" (admin marks payouts paid with a reference), "MPESA_B2C" or "TUMA".
  payoutGateway      String   @default("MANUAL")
  payoutMinKes       Decimal  @default(500) @db.Decimal(12, 2)
  payoutDay          Int      @default(5)
  holdDays           Int      @default(30)
  withholdingTaxRate Decimal  @default(0) @db.Decimal(5, 4)
  // The month ("2026-10") the automatic payout run last covered, so it runs once a month.
  lastRunMonth       String?
  updatedAt          DateTime @updatedAt

  @@map("sales_payout_settings")
}

// ── Rental / property management module (industryType "RENTAL") ──────────
// A landlord's buildings, the lettable units in them, the people renting
// them and the lease linking the two. Phase 1 is records only; rent
// invoicing and payments come in phase 2.

enum RentalUnitStatus {
  VACANT
  OCCUPIED
}

enum RentalLeaseStatus {
  ACTIVE
  ENDED
}

model RentalProperty {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  address        String?
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  units        RentalUnit[]
  maintenance  RentalMaintenanceRequest[]
  expenses     RentalExpense[]
  caretakers   RentalCaretakerProperty[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("rental_properties")
}

model RentalUnit {
  id             String           @id @default(uuid())
  organizationId String
  propertyId     String
  label          String // e.g. "A4", "Shop 2", "Bedsitter 7"
  monthlyRent    Decimal          @db.Decimal(12, 2)
  depositAmount  Decimal          @default(0) @db.Decimal(12, 2)
  status         RentalUnitStatus @default(VACANT)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization  Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property      RentalProperty             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases        RentalLease[]
  maintenance   RentalMaintenanceRequest[]
  expenses      RentalExpense[]
  meterReadings RentalMeterReading[]
  listing       RentalListing?

  @@unique([propertyId, label])
  @@index([organizationId])
  @@map("rental_units")
}

/// A public "House to let" advert for one vacant unit. Deliberately self-contained: it carries its own area, rent and
/// contact details (prefilled from the unit, editable) so the public pages never read the unit/property tables and
/// never expose a building's real address or its tenants. Shown only while isActive and confirmed in the last 30 days.
model RentalListing {
  id             String   @id @default(uuid())
  organizationId String
  unitId         String   @unique
  title          String
  unitType       String // BEDSITTER | SINGLE_ROOM | ONE_BEDROOM | TWO_BEDROOM | THREE_BEDROOM | SHOP | OFFICE | OTHER
  area           String // estate / town shown to the public, e.g. "Kasarani, Nairobi"
  monthlyRent    Decimal  @db.Decimal(12, 2)
  depositAmount  Decimal  @default(0) @db.Decimal(12, 2)
  description    String?
  contactName    String?
  contactPhone   String
  isActive       Boolean  @default(true)
  /// When the advert was last paid for / refreshed - used to order the public list, newest first.
  confirmedAt    DateTime @default(now())
  /// The advert is public until this moment. Each KES 100 payment pushes it 30 days on; null = never paid yet.
  paidUntil      DateTime?
  /// Set when ZARODA takes the advert down (abuse, fake listing...). While set the landlord cannot switch it back on.
  blockedReason  String?
  blockedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit         RentalUnit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  photos       RentalListingPhoto[]
  payments     RentalListingPayment[]

  @@index([organizationId])
  @@index([isActive, paidUntil])
  @@map("rental_listings")
}

/// A landlord's M-Pesa payment (to ZARODA's own Tuma account) for 30 days of one advert.
model RentalListingPayment {
  id                    String    @id @default(uuid())
  organizationId        String
  listingId             String // the first advert paid for (kept for the foreign key)
  /// Every advert this one payment covers - a landlord can pay once for several units (KES 100 each).
  listingIds            String[] @default([])
  amount                Int
  phone                 String
  status                String    @default("PENDING") // PENDING | PAID | FAILED
  tumaMerchantRequestId String?
  paymentReference      String? // M-Pesa receipt
  errorMessage          String?
  createdAt             DateTime  @default(now())
  paidAt                DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing      RentalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([listingId])
  @@map("rental_listing_payments")
}

model RentalListingPhoto {
  id         String   @id @default(uuid())
  listingId  String
  /// Object key in the Blob store: orgs/<organizationId>/listings/<listingId>/<uuid>.<ext>
  storageKey String   @unique
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  listing RentalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("rental_listing_photos")
}

model RentalTenant {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  phone           String?
  // The phone in 2547XXXXXXXX form (null if it is not a Kenyan mobile number): how a tenant who signs in by text message is found.
  phoneNormalized String?
  email           String?
  idNumber        String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leases       RentalLease[]
  maintenance  RentalMaintenanceRequest[]

  @@index([organizationId])
  @@index([phoneNormalized])
  @@map("rental_tenants")
}

// One unit has at most one ACTIVE lease at a time - enforced by a partial
// unique index in the migration (Prisma cannot express it).
model RentalLease {
  id              String            @id @default(uuid())
  organizationId  String
  unitId          String
  tenantId        String
  startDate       DateTime          @db.Date
  endDate         DateTime?         @db.Date // planned end; null = open-ended
  endedAt         DateTime?         @db.Date // when it actually ended
  monthlyRent     Decimal           @db.Decimal(12, 2) // agreed rent, copied from the unit but editable per lease
  depositAmount   Decimal           @default(0) @db.Decimal(12, 2)
  dueDay          Int               @default(1) // day of the month rent falls due, 1-28
  depositRefunded Decimal           @default(0) @db.Decimal(12, 2) // handed back to the tenant when the lease ended
  status          RentalLeaseStatus @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit          RentalUnit             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenant        RentalTenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoices      RentalInvoice[]
  payments      RentalPayment[]
  requests      RentalPaymentRequest[]
  meterReadings RentalMeterReading[]

  @@index([organizationId])
  @@index([unitId, status])
  @@index([tenantId])
  @@map("rental_leases")
}

// ── Rental module, phase 2: rent invoices and payments ───────────────────

enum RentalInvoiceKind {
  RENT
  DEPOSIT
  OTHER
}

enum RentalPaymentMethod {
  CASH
  BANK
  MPESA // an M-Pesa payment the landlord recorded by hand (e.g. from a Paybill statement)
  TUMA // an automatic M-Pesa prompt confirmed through the landlord's Tuma account
  DARAJA // an automatic M-Pesa prompt confirmed through the landlord's own Paybill/Till
  OTHER
}

// One amount a tenant owes: a month's rent, the deposit, or a one-off charge (water, repairs...).
// RENT and DEPOSIT rows are keyed by (lease, kind, month) so generating them twice is harmless.
model RentalInvoice {
  id             String            @id @default(uuid())
  organizationId String
  leaseId        String
  kind           RentalInvoiceKind
  periodMonth    DateTime?         @db.Date // first day of the month a RENT/DEPOSIT row belongs to; null for OTHER
  description    String?
  amountDue      Decimal           @db.Decimal(12, 2)
  amountPaid     Decimal           @default(0) @db.Decimal(12, 2)
  dueDate        DateTime          @db.Date
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lease        RentalLease               @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  allocations  RentalPaymentAllocation[]

  @@unique([leaseId, kind, periodMonth])
  @@index([organizationId])
  @@index([leaseId, dueDate])
  @@map("rental_invoices")
}

// Money received from a tenant. How much of it has been applied to which invoice is in the allocations;
// anything not yet applied is the tenant's credit and is used as new invoices appear. A mistaken payment
// is voided (kept for the record) rather than deleted.
model RentalPayment {
  id             String              @id @default(uuid())
  organizationId String
  leaseId        String
  amount         Decimal             @db.Decimal(12, 2)
  method         RentalPaymentMethod
  reference      String? // M-Pesa code, bank reference, cheque number... one per business, so a code cannot be entered twice
  paidAt         DateTime            @db.Date
  note           String?
  receiptNumber  String
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime            @default(now())

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lease        RentalLease               @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  allocations  RentalPaymentAllocation[]

  @@unique([organizationId, reference])
  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([leaseId, paidAt])
  @@map("rental_payments")
}

model RentalPaymentAllocation {
  id             String   @id @default(uuid())
  organizationId String
  paymentId      String
  invoiceId      String
  amount         Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      RentalPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice      RentalInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([paymentId])
  @@index([invoiceId])
  @@map("rental_payment_allocations")
}

// ── Rental module, phase 2B: automatic M-Pesa rent collection ────────────

enum RentalPaymentRequestStatus {
  PENDING
  PAID
  FAILED
  REVIEW // M-Pesa reported something that does not match the request - a person must look
}

// How a landlord collects rent by M-Pesa: through their own Tuma account, or straight into their own Paybill/Till
// (Safaricom Daraja). The same fields and rules as the online shop's OnlineStore, kept separate so a landlord does
// not need the shop add-on. Keys are stored encrypted (SECRETS_ENCRYPTION_KEY) and never sent back to the browser.
model RentalSettings {
  id                           String    @id @default(uuid())
  organizationId               String    @unique
  paymentGateway               String    @default("TUMA") // 'TUMA' | 'DARAJA'
  tumaEmail                    String?
  tumaApiKeyEncrypted          String?
  mpesaAccountType             String? // 'PAYBILL' | 'TILL'
  mpesaShortcode               String?
  mpesaTillNumber              String?
  mpesaConsumerKeyEncrypted    String?
  mpesaConsumerSecretEncrypted String?
  mpesaPasskeyEncrypted        String?
  mpesaEnvironment             String    @default("production")
  remindersEnabled             Boolean   @default(false)
  smsReminders                 Boolean   @default(false)
  paymentInstructions          String?
  // The landlord's ZARODA plan (see rental-plans.util.ts). A landlord with no row yet is on 'bure'. Strings, not enums,
  // so the later 'growth' and 'agency' plans need no migration.
  plan                         String    @default("bure") // 'bure' | 'starter' | 'collect'
  billingCycle                 String    @default("monthly") // 'monthly' | 'annual'
  // A move to a cheaper plan waits for the next billing cycle (pendingPlanFrom); a move up applies at once.
  pendingPlan                  String?
  pendingPlanFrom              DateTime?
  // The first 20 paying landlords keep their launch price until this date.
  foundingPriceUntil           DateTime?
  // Landlords who were already using rentals before plans existed: no charge until this date.
  planFreeUntil                DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("rental_settings")
}

// One M-Pesa prompt sent to a tenant's phone. When M-Pesa confirms it, a RentalPayment is recorded (paymentId) and
// applied to the tenant's invoices like any other payment.
model RentalPaymentRequest {
  id             String                     @id @default(uuid())
  organizationId String
  leaseId        String
  invoiceId      String? // pay this invoice first, when the prompt was started from one
  amount         Decimal                    @db.Decimal(12, 2)
  phone          String
  gateway        String // 'TUMA' | 'DARAJA'
  requestId      String? // Tuma's merchant request id / Safaricom's CheckoutRequestID
  status         RentalPaymentRequestStatus @default(PENDING)
  mpesaReceipt   String?
  paymentId      String?                    @unique
  lastError      String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lease        RentalLease  @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([leaseId, createdAt])
  @@index([status, createdAt])
  @@map("rental_payment_requests")
}

// ── Rental module, phase 3: expenses, maintenance, meters, reminders ─────

enum RentalExpenseCategory {
  REPAIRS
  UTILITIES
  RATES_AND_TAXES
  INSURANCE
  CARETAKER
  MANAGEMENT_FEE
  OTHER
}

enum RentalMaintenanceStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum RentalMaintenancePriority {
  LOW
  NORMAL
  URGENT
}

enum RentalMeterKind {
  WATER
  ELECTRICITY
}

// A repair or problem reported on a property or one of its units, tracked until it is done.
model RentalMaintenanceRequest {
  id             String                    @id @default(uuid())
  organizationId String
  propertyId     String
  unitId         String?
  tenantId       String? // who reported it, when a tenant did
  title          String
  description    String?
  priority       RentalMaintenancePriority @default(NORMAL)
  status         RentalMaintenanceStatus   @default(OPEN)
  reportedAt     DateTime                  @db.Date
  resolvedAt     DateTime?                 @db.Date
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     RentalProperty  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit         RentalUnit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tenant       RentalTenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  expenses     RentalExpense[]

  @@index([organizationId, status])
  @@index([propertyId])
  @@map("rental_maintenance_requests")
}

// Money a landlord spends on a property (repairs, rates, caretaker...), so profit per property can be reported.
model RentalExpense {
  id             String                @id @default(uuid())
  organizationId String
  propertyId     String
  unitId         String?
  maintenanceId  String? // the repair this paid for, when there is one
  category       RentalExpenseCategory
  description    String
  vendor         String?
  amount         Decimal               @db.Decimal(12, 2)
  incurredAt     DateTime              @db.Date
  createdAt      DateTime              @default(now())

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     RentalProperty            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit         RentalUnit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  maintenance  RentalMaintenanceRequest? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)

  @@index([organizationId, incurredAt])
  @@index([propertyId, incurredAt])
  @@map("rental_expenses")
}

// A water or electricity meter reading for a unit. Consumption since the previous reading, at the rate entered, is
// billed to the tenant as a one-off charge (chargeInvoiceId).
model RentalMeterReading {
  id              String          @id @default(uuid())
  organizationId  String
  unitId          String
  leaseId         String? // the tenant who was in the unit and was charged
  kind            RentalMeterKind
  readingDate     DateTime        @db.Date
  reading         Decimal         @db.Decimal(12, 2)
  previousReading Decimal?        @db.Decimal(12, 2)
  unitsUsed       Decimal?        @db.Decimal(12, 2)
  ratePerUnit     Decimal?        @db.Decimal(12, 2)
  chargeInvoiceId String?
  createdAt       DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit         RentalUnit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  lease        RentalLease? @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  @@unique([unitId, kind, readingDate])
  @@index([organizationId])
  @@index([unitId, kind, readingDate])
  @@map("rental_meter_readings")
}

// Each reminder sent once per invoice, stage and channel, so the hourly job never nags twice.
model RentalReminderLog {
  id             String   @id @default(uuid())
  organizationId String
  invoiceId      String
  stage          String // UPCOMING | DUE | OVERDUE | FINAL
  channel        String // EMAIL | SMS
  sentAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, stage, channel])
  @@index([organizationId])
  @@map("rental_reminder_logs")
}

enum RentalPlatformInvoiceStatus {
  ISSUED
  PAID
  WAIVED
}

// What ZARODA bills a landlord for the rental plan (not what tenants pay the landlord - those are RentalInvoice).
// SUBSCRIPTION = the flat Starter fee (monthly, or 12 months at once for annual); COLLECTION_FEE = 1% of the rent
// matched through the landlord's gateway in the previous month (Pay-as-you-collect). Issued on the 1st, due on the 15th,
// reminded on days 1, 5 and 10; unpaid on the 15th the landlord's account becomes read-only (never deleted).
model RentalPlatformInvoice {
  id                        String                      @id @default(uuid())
  organizationId            String
  invoiceNumber             String                      @unique
  kind                      String // 'SUBSCRIPTION' | 'COLLECTION_FEE'
  // The month it was issued, '2026-11'. One of each kind per landlord per month.
  invoiceMonth              String
  // What it covers: the plan period for a subscription, the previous month's rent for a collection fee.
  periodStart               DateTime
  periodEnd                 DateTime
  plan                      String
  billingCycle              String
  // Units with an active lease on the 1st of the month, kept on the invoice as the billing record.
  occupiedUnits             Int
  // Rent matched through the gateway in the period (collection fee only).
  matchedRentTotal          Decimal?                    @db.Decimal(12, 2)
  // Whole shillings (M-Pesa only moves whole shillings); the fee is rounded up.
  amountDue                 Int
  status                    RentalPlatformInvoiceStatus @default(ISSUED)
  issuedAt                  DateTime                    @default(now())
  dueDate                   DateTime
  paidAt                    DateTime?
  paymentMethod             String? // 'MPESA' | 'BANK' | 'CASH'
  paymentReference          String?
  recordedByPlatformAdminId String?
  waivedReason              String?
  // Online payment through ZARODA's own Tuma account (like a shop's commission): the latest M-Pesa prompt and why the
  // last attempt failed.
  tumaMerchantRequestId     String?
  payPhone                  String?
  payAttemptedAt            DateTime?
  lastPaymentError          String?
  // Furthest notice emailed (0 none, 1 issued, 2 reminder, 3 final reminder, 4 account read-only) - each goes out once.
  reminderStage             Int                         @default(0)
  emailedAt                 DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind, invoiceMonth])
  @@index([organizationId, status])
  @@map("rental_platform_invoices")
}

// Which properties a caretaker may work on. A caretaker with no rows here sees nothing; owners and managers are never
// limited. Checked on the server for every rental screen (rental-caretaker-scope.ts).
model RentalCaretakerProperty {
  id             String   @id @default(uuid())
  organizationId String
  orgUserId      String
  propertyId     String
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgUser      OrgUser        @relation(fields: [orgUserId], references: [id], onDelete: Cascade)
  property     RentalProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([orgUserId, propertyId])
  @@index([organizationId])
  @@map("rental_caretaker_properties")
}

// ── Rental module, phase 4: the tenant's own sign-in ─────────────────────
// A tenant signs in with a 6-digit code emailed to the address their landlord has on file (no password), then sees only
// their own balance, receipts and requests. The address is the identity, so the same person renting from two landlords
// sees both under one sign-in. Platform-level like rider_otps: there is no business behind a sign-in attempt yet.
model RentalTenantOtp {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@map("rental_tenant_otps")
}

// ─────────────────────────────────────────────────────────────────────────
// School suppliers: businesses that sell to schools on credit (price list online, school orders, delivery notes, invoices,
// cheque payments with receipts, statements) and also sell for cash over the counter (the ordinary till).
// ─────────────────────────────────────────────────────────────────────────

enum SchoolStatus {
  ACTIVE
  SUSPENDED
}

enum SchoolOrderStatus {
  SUBMITTED // the school has sent it; the supplier has not answered yet
  CONFIRMED // the supplier has confirmed it (maybe with changed quantities) and will deliver
  PARTIALLY_DELIVERED // some goods have gone out (each delivery has its own delivery note and invoice); a balance is still to come
  DELIVERED // everything confirmed has been delivered (or the supplier closed the balance)
  CANCELLED
}

enum SchoolTenderStatus {
  IDENTIFIED // spotted, not started
  PREPARING // the bid is being put together
  SUBMITTED
  WON // awarded: a contract was made
  LOST
  WITHDRAWN
  CANCELLED // the institution cancelled the tender
}

enum SchoolContractStatus {
  ACTIVE
  COMPLETED
  TERMINATED
}

enum SchoolQuoteStatus {
  DRAFT // being written; can still change
  ISSUED // numbered, frozen and sent to the school
  ACCEPTED // the school said yes: an order was made from it
  DECLINED
  EXPIRED // the valid-until date passed
  SUPERSEDED // replaced by a revised quotation
}

enum SupplierInvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  WRITTEN_OFF // what was left was written off as a bad debt
}

/// Why a school is credited.
enum SchoolCreditReason {
  RETURNED // goods came back
  DAMAGED // arrived damaged
  SHORT_DELIVERY // invoiced but not all of it arrived
  PRICE_ERROR // charged the wrong price
  OTHER
}

enum SupplierPaymentMethod {
  CHEQUE
  BANK_TRANSFER
  MPESA
  CASH
  /// Not money: tax the school kept back and pays to KRA on the supplier's behalf. It settles the invoice like a payment and is backed by a withholding certificate.
  WITHHOLDING_TAX
}

enum SupplierPaymentStatus {
  RECEIVED
  BOUNCED // a cheque that did not clear: what it paid is undone
}

enum TenderBuyerStatus {
  PENDING // registered, waiting for the platform owner to check it is a real school
  APPROVED // may post tender adverts
  SUSPENDED
}

enum TenderAdvertStatus {
  OPEN
  CANCELLED // the school withdrew it
  REMOVED // taken down by the platform owner
}

enum TenderNoticeState {
  SEEN
  SAVED
  DISMISSED
}

/// A school (or other institution) that posts tender adverts for suppliers to see. Not a customer of any one supplier, so it is not
/// tenant-scoped (like buyers and riders): it signs in by phone + PIN and can only ever touch its own adverts.
model TenderBuyer {
  id             String            @id @default(uuid())
  name           String
  contactName    String
  /// Normalized 2547XXXXXXXX / 2541XXXXXXXX. One account per number.
  phone          String            @unique
  email          String?
  county         String
  pinHash        String
  pinFailCount   Int               @default(0)
  pinLockedUntil DateTime?
  status         TenderBuyerStatus @default(PENDING)
  statusNote     String?
  /// Set when the account was made from a supplier's school portal (the supplier's school it stands for, and the supplier). Such an
  /// account never signs in on the tender page: the school posts through its portal sign-in.
  supplierSchoolId String? @unique
  supplierOrgId    String?
  lastLoginAt    DateTime?
  createdAt      DateTime          @default(now())

  adverts TenderAdvert[]

  @@map("tender_buyers")
}

/// A tender advert: what the school wants to buy, by when, and who to contact. Visible to every school-supplier business.
model TenderAdvert {
  id            String             @id @default(uuid())
  buyerId       String
  /// The school's own tender number, if it has one.
  reference     String?
  title         String
  description   String
  county        String
  /// What is wanted: [{ description, quantity, unit }].
  items         Json               @default("[]")
  /// How suppliers get the full tender documents (a link, or "collect at the school office").
  documentsInfo String?
  /// The school's own tender document (PDF), kept in the shared file store: its key there and the name it had.
  pdfKey        String?
  pdfName       String?
  closingDate   DateTime           @db.Date
  contactName   String
  contactPhone  String
  contactEmail  String?
  status        TenderAdvertStatus @default(OPEN)
  removedReason String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  buyer   TenderBuyer          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  notices SchoolTenderNotice[]

  @@index([status, closingDate])
  @@index([buyerId])
  @@map("tender_adverts")
}

/// What one supplier has done with an advert (seen, saved for later, dismissed). An advert with no row here is new to that supplier.
model SchoolTenderNotice {
  id             String            @id @default(uuid())
  organizationId String
  advertId       String
  state          TenderNoticeState
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  advert       TenderAdvert @relation(fields: [advertId], references: [id], onDelete: Cascade)

  @@unique([organizationId, advertId])
  @@index([organizationId])
  @@map("school_tender_notices")
}

/// A tender the business is bidding for: the institution inviting it, the closing date, the checklist of what must be ready,
/// the bid costing, and what happened. A won tender becomes a contract.
model SchoolTender {
  id             String             @id @default(uuid())
  organizationId String
  /// A school the business already sells to, when the tender is from one (a county office, a ministry, a new school: just a name).
  schoolId       String?
  entityName     String
  /// The institution's own tender reference.
  tenderNumber   String
  title          String
  status         SchoolTenderStatus @default(IDENTIFIED)
  closingDate    DateTime?          @db.Date
  submittedOn    DateTime?          @db.Date
  /// What the bid comes to, VAT included (worked out from the bid lines).
  bidAmount      Decimal?           @db.Decimal(14, 2)
  /// A person overrode a block (an expired compliance document, an unticked checklist item) to submit: why.
  submitOverride String?
  outcomeNote    String?
  notes          String?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       SupplierSchool?    @relation(fields: [schoolId], references: [id])
  checklist    SchoolTenderCheck[]
  lines        SchoolTenderLine[]
  contract     SchoolContract?

  @@unique([organizationId, tenderNumber])
  @@index([organizationId, status])
  @@map("school_tenders")
}

model SchoolTenderCheck {
  id        String       @id @default(uuid())
  tenderId  String
  title     String
  done      Boolean      @default(false)
  doneAt    DateTime?
  sortOrder Int          @default(0)

  tender SchoolTender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
  @@map("school_tender_checks")
}

/// One line of the bid: what is offered, what it costs the business and what it is priced at (before VAT).
model SchoolTenderLine {
  id          String   @id @default(uuid())
  tenderId    String
  variantId   String?
  description String
  quantity    Decimal  @db.Decimal(14, 3)
  unitCost    Decimal  @default(0) @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  /// VAT as a fraction (0.16), 0 when exempt.
  taxRate     Decimal  @default(0) @db.Decimal(6, 4)
  sortOrder   Int      @default(0)

  tender  SchoolTender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([tenderId])
  @@map("school_tender_lines")
}

/// A document the business must keep valid to bid (tax compliance certificate, business permit...): a tender cannot be submitted
/// while one has expired.
model SchoolComplianceDoc {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  reference      String?
  issuedOn       DateTime? @db.Date
  expiryDate     DateTime? @db.Date
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("school_compliance_docs")
}

/// An agreement to supply a school (usually from a won tender): its value, period, the orders and invoices charged to it.
model SchoolContract {
  id             String               @id @default(uuid())
  organizationId String
  schoolId       String
  tenderId       String?              @unique
  /// "CT-2026-0001"
  contractNumber String               @unique
  /// The institution's own contract reference.
  reference      String?
  title          String
  status         SchoolContractStatus @default(ACTIVE)
  startDate      DateTime             @db.Date
  endDate        DateTime             @db.Date
  /// The value agreed, VAT included. Variations change what it stands at.
  value          Decimal              @db.Decimal(14, 2)
  /// A share of each invoice charged to this contract that the school holds back, and how many days after the invoice it is released.
  retentionPercent     Decimal @default(0) @db.Decimal(5, 2)
  retentionReleaseDays Int     @default(0)
  notes          String?
  closedAt       DateTime?
  closedNote     String?
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       SupplierSchool            @relation(fields: [schoolId], references: [id])
  tender       SchoolTender?             @relation(fields: [tenderId], references: [id])
  variations   SchoolContractVariation[]
  orders       SchoolOrder[]
  invoices     SupplierInvoice[]

  @@index([organizationId, status])
  @@index([schoolId])
  @@map("school_contracts")
}

/// A change to a contract's value (more goods asked for, a price change, a reduction), signed.
model SchoolContractVariation {
  id         String   @id @default(uuid())
  contractId String
  date       DateTime @db.Date
  amount     Decimal  @db.Decimal(14, 2)
  reason     String
  createdById String?
  createdAt  DateTime @default(now())

  contract SchoolContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("school_contract_variations")
}

/// A price quotation to a school. Issued quotations are frozen; when the school accepts, an order is made at the quoted prices.
model SchoolQuote {
  id             String            @id @default(uuid())
  organizationId String
  schoolId       String
  /// "QT-2026-0001", given when the quotation is issued (a draft has none).
  quoteNumber    String?           @unique
  status         SchoolQuoteStatus @default(DRAFT)
  validUntil     DateTime?         @db.Date
  terms          String?
  issueDate      DateTime?         @db.Date
  issuedAt       DateTime?
  decidedAt      DateTime?
  /// SCHOOL | SUPPLIER: who recorded the answer.
  decidedBy      String?
  decisionNote   String?
  /// The quotation this one revises.
  revisionOfId   String?
  /// The order made when it was accepted.
  orderId        String?           @unique
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       SupplierSchool  @relation(fields: [schoolId], references: [id])
  revisionOf   SchoolQuote?    @relation("QuoteRevisions", fields: [revisionOfId], references: [id])
  revisions    SchoolQuote[]   @relation("QuoteRevisions")
  order        SchoolOrder?    @relation(fields: [orderId], references: [id])
  lines        SchoolQuoteLine[]

  @@index([organizationId, status])
  @@index([schoolId])
  @@map("school_quotes")
}

model SchoolQuoteLine {
  id          String  @id @default(uuid())
  quoteId     String
  variantId   String
  /// Written down when the line is added, so the quotation reads the same later whatever happens to the product.
  productName String
  variantSku  String
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  /// VAT as a fraction (0.16), 0 when exempt.
  taxRate     Decimal @default(0) @db.Decimal(6, 4)

  quote   SchoolQuote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([quoteId])
  @@map("school_quote_lines")
}

/// The public address of a supplier's school portal ("/schools/<slug>"). Readable without signing in only while enabled.
model SchoolPortal {
  id             String   @id @default(uuid())
  organizationId String   @unique
  slug           String   @unique
  displayName    String
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("school_portals")
}

/// A school the supplier sells to. The supplier creates it and gives the school's contact person a phone number and PIN.
model SupplierSchool {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  contactName    String?
  /// Normalized 2547XXXXXXXX - the contact person's sign-in on the school portal.
  phone          String
  email          String?
  address        String?
  county         String?
  /// What the school may owe at once; an order that would take it past this is flagged for the supplier (not refused).
  creditLimit    Decimal?     @db.Decimal(12, 2)
  /// Days after an invoice is issued that it is due.
  creditDays     Int          @default(30)
  /// A share of each invoice the school holds back until it is released (0 = none), and how many days after the invoice that is. A contract can set its own.
  retentionPercent     Decimal @default(0) @db.Decimal(5, 2)
  retentionReleaseDays Int     @default(0)
  status         SchoolStatus @default(ACTIVE)
  pinHash        String?
  pinFailCount   Int          @default(0)
  pinLockedUntil DateTime?
  lastLoginAt    DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       SchoolOrder[]
  invoices     SupplierInvoice[]
  payments     SupplierPayment[]
  creditNotes  SupplierCreditNote[]
  quotes       SchoolQuote[]
  tenders      SchoolTender[]
  contracts    SchoolContract[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@map("supplier_schools")
}

model SchoolOrder {
  id               String            @id @default(uuid())
  organizationId   String
  schoolId         String
  /// "SO-2026-0001": the supplier's own number, quoted by both sides.
  orderNumber      String            @unique
  /// The school's own order number (LPO), if it has one.
  lpoNumber        String?
  /// The school's LPO was received and checked against its signed copy (who, and when).
  lpoVerifiedAt    DateTime?
  lpoVerifiedByName String?
  /// The contract this order is supplied under (its deliveries and invoices are charged to it).
  contractId       String?
  status           SchoolOrderStatus @default(SUBMITTED)
  notes            String?
  deliveryAddress  String?
  requestedDate    DateTime?         @db.Date
  /// True when this order, on top of what the school already owes, goes past its credit limit.
  overCreditLimit  Boolean           @default(false)
  submittedAt      DateTime          @default(now())
  confirmedAt      DateTime?
  confirmationNote String?
  deliveredAt      DateTime?
  /// "DN-2026-0001": the delivery note's number.
  deliveryNoteNumber String?         @unique
  receivedByName   String?
  deliveryNotes    String?
  deliveredById    String?
  /// Set when the supplier closed the order with some of it never delivered (the balance is dropped).
  balanceClosedAt  DateTime?
  balanceClosedNote String?
  cancelledAt      DateTime?
  cancelledBy      String? // SCHOOL | SUPPLIER
  cancelReason     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       SupplierSchool    @relation(fields: [schoolId], references: [id])
  lines        SchoolOrderLine[]
  deliveries   SchoolDelivery[]
  invoices     SupplierInvoice[]
  quote        SchoolQuote?
  contract     SchoolContract? @relation(fields: [contractId], references: [id])

  @@index([organizationId, status])
  @@index([schoolId])
  @@index([contractId])
  @@map("school_orders")
}

model SchoolOrderLine {
  id                String  @id @default(uuid())
  orderId           String
  variantId         String
  /// Written down when the order is placed, so the order reads the same later whatever happens to the product.
  productName       String
  variantSku        String
  unitPrice         Decimal @db.Decimal(12, 2)
  /// VAT as a fraction (0.16), 0 when exempt.
  taxRate           Decimal @default(0) @db.Decimal(6, 4)
  quantityOrdered   Decimal @db.Decimal(14, 3)
  quantityConfirmed Decimal? @db.Decimal(14, 3)
  /// Everything delivered so far, over all the deliveries of the order.
  quantityDelivered Decimal? @db.Decimal(14, 3)

  order           SchoolOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant         ProductVariant       @relation(fields: [variantId], references: [id])
  deliveryLines   SchoolDeliveryLine[]

  @@index([orderId])
  @@map("school_order_lines")
}

/// One drop of goods to a school: its own delivery note and its own invoice. An order may have several (the rest of it follows later).
model SchoolDelivery {
  id                 String    @id @default(uuid())
  organizationId     String
  orderId            String
  /// 1, 2, 3... within the order.
  sequence           Int
  /// "DN-2026-0001"
  deliveryNoteNumber String    @unique
  deliveredAt        DateTime
  branchId           String?
  receivedByName     String
  notes              String?
  deliveredById      String?
  /// The school confirming in its portal that the goods arrived.
  schoolConfirmedAt  DateTime?
  schoolConfirmedBy  String?
  schoolConfirmNote  String?
  createdAt          DateTime  @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        SchoolOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines        SchoolDeliveryLine[]
  invoice      SupplierInvoice?

  @@unique([orderId, sequence])
  @@index([organizationId])
  @@map("school_deliveries")
}

model SchoolDeliveryLine {
  id          String  @id @default(uuid())
  deliveryId  String
  orderLineId String
  quantity    Decimal @db.Decimal(14, 3)

  delivery  SchoolDelivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderLine SchoolOrderLine @relation(fields: [orderLineId], references: [id])

  @@index([deliveryId])
  @@index([orderLineId])
  @@map("school_delivery_lines")
}

model SupplierInvoice {
  id             String                @id @default(uuid())
  organizationId String
  schoolId       String
  orderId        String?
  /// The delivery this invoice is for (one invoice per delivery).
  deliveryId     String?               @unique
  /// The ordinary sale this invoice was also recorded as, so it appears in Sales and the reports.
  saleId         String?               @unique
  /// The contract it is charged to (taken from the order when the goods were delivered).
  contractId     String?
  /// Retention: the share of this invoice the school holds back (what was held at the start, and what is still held), when it is
  /// expected to be released, and the follow-up: a release asked for, a dispute, a note. Held retention is not yet due.
  retentionAmount      Decimal   @default(0) @db.Decimal(12, 2)
  retentionHeld        Decimal   @default(0) @db.Decimal(12, 2)
  retentionReleaseDate DateTime? @db.Date
  retentionRequestedAt DateTime?
  retentionDisputed    Boolean   @default(false)
  retentionDisputeNote String?
  retentionNote        String?
  /// What has been written off as a bad debt (taken off what is owed).
  writtenOffAmount     Decimal   @default(0) @db.Decimal(12, 2)
  /// "INV-2026-0001"
  invoiceNumber  String                @unique
  issueDate      DateTime              @db.Date
  dueDate        DateTime              @db.Date
  subtotal       Decimal               @db.Decimal(12, 2)
  taxAmount      Decimal               @db.Decimal(12, 2)
  total          Decimal               @db.Decimal(12, 2)
  amountPaid     Decimal               @default(0) @db.Decimal(12, 2)
  /// Taken off what is owed by credit notes (goods returned, a short delivery, a price correction). Owed = total - credits - paid.
  creditAmount   Decimal               @default(0) @db.Decimal(12, 2)
  status         SupplierInvoiceStatus @default(ISSUED)
  /// Chasing an unpaid invoice: when the school promised to pay, whether it disputes the invoice (and why), who is following it up, and notes.
  expectedPaymentDate DateTime?         @db.Date
  disputed       Boolean               @default(false)
  disputeNote    String?
  followUpNote   String?
  /// The member of staff chasing it (an OrgUser id).
  responsibleId  String?
  followUpUpdatedAt DateTime?
  notes          String?
  voidedAt       DateTime?
  voidReason     String?
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       SupplierSchool              @relation(fields: [schoolId], references: [id])
  order        SchoolOrder?                @relation(fields: [orderId], references: [id])
  delivery     SchoolDelivery?             @relation(fields: [deliveryId], references: [id])
  contract     SchoolContract?             @relation(fields: [contractId], references: [id])
  retentionEvents SupplierRetentionEvent[]
  writeOffs       SchoolWriteOff[]
  lines        SupplierInvoiceLine[]
  allocations  SupplierPaymentAllocation[]
  creditNotes  SupplierCreditNote[]

  @@index([organizationId, status])
  @@index([schoolId])
  @@index([orderId])
  @@index([contractId])
  @@map("supplier_invoices")
}

model SupplierInvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  variantId   String?
  description String
  quantity    Decimal @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(6, 4)
  /// quantity x unitPrice, before VAT.
  lineTotal   Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @db.Decimal(12, 2)
  /// What the goods cost the supplier when delivered, for the profit report (null = no cost known).
  unitCost    Decimal? @db.Decimal(12, 2)

  invoice     SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  creditLines SupplierCreditNoteLine[]

  @@index([invoiceId])
  @@map("supplier_invoice_lines")
}

enum CashflowDirection {
  IN
  OUT
}

enum CashflowRepeat {
  NONE
  WEEKLY
  MONTHLY
}

/// What the cash-flow forecast starts from: the cash on hand (entered, as the system does not see the bank) and the least cash wanted.
model SchoolCashflowSettings {
  id              String    @id @default(uuid())
  organizationId  String    @unique
  openingCash     Decimal   @default(0) @db.Decimal(14, 2)
  openingCashAsOf DateTime? @db.Date
  minimumCash     Decimal   @default(0) @db.Decimal(14, 2)
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("school_cashflow_settings")
}

/// Money the supplier expects to receive or pay that is not on an invoice or bill: salaries, rent, a loan repayment, a grant. Can repeat.
model SchoolCashflowItem {
  id             String            @id @default(uuid())
  organizationId String
  direction      CashflowDirection
  description    String
  amount         Decimal           @db.Decimal(12, 2)
  date           DateTime          @db.Date
  repeat         CashflowRepeat    @default(NONE)
  repeatUntil    DateTime?         @db.Date
  notes          String?
  active         Boolean           @default(true)
  createdByName  String?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, active])
  @@map("school_cashflow_items")
}

enum WriteOffStatus {
  PENDING // asked for, waiting for a second person
  APPROVED // taken off what is owed
  REJECTED
  REVERSED // put back: the school paid after all, or it was a mistake
}

/// The supplier's bad-debt rules: the share of each overdue band set aside, and the size of a write-off that needs a second person.
model SchoolBadDebtSettings {
  id                String   @id @default(uuid())
  organizationId    String   @unique
  rate1To30         Decimal  @default(1) @db.Decimal(5, 2)
  rate31To60        Decimal  @default(5) @db.Decimal(5, 2)
  rate61To90        Decimal  @default(20) @db.Decimal(5, 2)
  rate91To180       Decimal  @default(50) @db.Decimal(5, 2)
  rateOver180       Decimal  @default(100) @db.Decimal(5, 2)
  /// A write-off of this much or more needs a second person to approve it (0 = every one does).
  approvalThreshold Decimal  @default(50000) @db.Decimal(12, 2)
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("school_bad_debt_settings")
}

/// A debt written off. Asked for by one person, approved by another (or by an owner on their own, with the reason kept).
model SchoolWriteOff {
  id               String         @id @default(uuid())
  organizationId   String
  invoiceId        String
  amount           Decimal        @db.Decimal(12, 2)
  reason           String
  status           WriteOffStatus
  requestedById    String
  requestedByName  String?
  requestedAt      DateTime       @default(now())
  decidedById      String?
  decidedByName    String?
  decidedAt        DateTime?
  decisionNote     String?
  /// Set when the person who asked also approved it: why nobody else could.
  overrideReason   String?
  reversedAt       DateTime?
  reversedByName   String?
  reversalReason   String?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([invoiceId])
  @@map("school_write_offs")
}

/// The provision (what is set aside for debts that may not be paid) as it stood when it was recorded.
model SchoolProvisionEntry {
  id             String   @id @default(uuid())
  organizationId String
  asOf           DateTime @db.Date
  /// The provision then, what it was before, and the overdue amount it was worked out on.
  amount         Decimal  @db.Decimal(14, 2)
  previous       Decimal  @db.Decimal(14, 2)
  overdue        Decimal  @db.Decimal(14, 2)
  note           String?
  byName         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, asOf])
  @@map("school_provision_entries")
}

enum RetentionEventKind {
  HELD // retention was held back when the invoice was made
  RELEASE_REQUESTED // the school (or the supplier on its behalf) asked for it to be released... or the supplier asked the school to release it
  RELEASED // some or all of it became due
  UPDATED // the expected date, a dispute or a note changed
}

/// What happened to the retention on an invoice, in order.
model SupplierRetentionEvent {
  id             String             @id @default(uuid())
  organizationId String
  invoiceId      String
  kind           RetentionEventKind
  amount         Decimal?           @db.Decimal(12, 2)
  note           String?
  /// Who did it (a name), or the school.
  byName         String?
  createdAt      DateTime           @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([organizationId])
  @@map("supplier_retention_events")
}

/// A credit to a school against one of its invoices: goods sent back, a short delivery, a price correction. It lowers what the
/// school owes (and, if the goods came back, puts them back in stock). Never edited or deleted: a mistake is put right with another entry.
model SupplierCreditNote {
  id             String             @id @default(uuid())
  organizationId String
  schoolId       String
  invoiceId      String
  /// "CN-2026-0001"
  creditNumber   String             @unique
  issueDate      DateTime           @db.Date
  reason         SchoolCreditReason
  note           String?
  subtotal       Decimal            @db.Decimal(12, 2)
  taxAmount      Decimal            @db.Decimal(12, 2)
  total          Decimal            @db.Decimal(12, 2)
  /// The branch the returned goods went back into, when some did.
  branchId       String?
  createdById    String?
  createdAt      DateTime           @default(now())

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       SupplierSchool           @relation(fields: [schoolId], references: [id])
  invoice      SupplierInvoice          @relation(fields: [invoiceId], references: [id])
  lines        SupplierCreditNoteLine[]

  @@index([organizationId, issueDate])
  @@index([schoolId])
  @@index([invoiceId])
  @@map("supplier_credit_notes")
}

model SupplierCreditNoteLine {
  id            String  @id @default(uuid())
  creditNoteId  String
  invoiceLineId String
  description   String
  quantity      Decimal @db.Decimal(14, 3)
  unitPrice     Decimal @db.Decimal(12, 2)
  taxRate       Decimal @default(0) @db.Decimal(6, 4)
  lineTotal     Decimal @db.Decimal(12, 2)
  taxAmount     Decimal @db.Decimal(12, 2)
  /// How much of this quantity physically came back into stock.
  quantityRestocked Decimal @default(0) @db.Decimal(14, 3)

  creditNote  SupplierCreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoiceLine SupplierInvoiceLine @relation(fields: [invoiceLineId], references: [id])

  @@index([creditNoteId])
  @@index([invoiceLineId])
  @@map("supplier_credit_note_lines")
}

/// Money received from a school (a cheque, a bank transfer...), with the receipt number the school is given.
model SupplierPayment {
  id             String                @id @default(uuid())
  organizationId String
  schoolId       String
  /// "RC-2026-0001"
  receiptNumber  String                @unique
  amount         Decimal               @db.Decimal(12, 2)
  method         SupplierPaymentMethod
  /// The cheque number, bank reference or M-Pesa code.
  reference      String?
  bankName       String?
  chequeDate     DateTime?             @db.Date
  receivedOn     DateTime              @db.Date
  status         SupplierPaymentStatus @default(RECEIVED)
  bouncedAt      DateTime?
  bounceReason   String?
  notes          String?
  recordedById   String?
  /// For tax withheld by the school: the certificate it issues (number, and the day it reached us). Missing until we have it.
  whtCertificateNumber     String?
  whtCertificateReceivedOn DateTime? @db.Date
  createdAt      DateTime              @default(now())

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  school       SupplierSchool              @relation(fields: [schoolId], references: [id])
  allocations  SupplierPaymentAllocation[]

  @@index([organizationId, receivedOn])
  @@index([schoolId])
  @@map("supplier_payments")
}

/// Which invoice (and how much of it) a payment was used for. A payment can be spread over several invoices, and an invoice
/// can be paid by several payments; what is left of a payment over its allocations stays as credit on the school's account.
model SupplierPaymentAllocation {
  id        String  @id @default(uuid())
  paymentId String
  invoiceId String
  amount    Decimal @db.Decimal(12, 2)

  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
  @@map("supplier_payment_allocations")
}

/// Running numbers for printed documents, one counter per business, kind and year (INV-2026-0001, DN-..., RC-..., SO-...).
model DocumentCounter {
  organizationId String
  kind           String
  year           Int
  last           Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, kind, year])
  @@map("document_counters")
}

// ─────────────────────────────────────────────────────────────────────────
// Receiving stock and paying suppliers
// ─────────────────────────────────────────────────────────────────────────

/// A goods-received note: what actually arrived, in one document - against a purchase order or without one. The stock goes up through
/// the ordinary ledger (type RECEIPT) in the same transaction.
model GoodsReceipt {
  id              String   @id @default(uuid())
  organizationId  String
  branchId        String
  /// "GRN-2026-0001", numbered per business per year.
  receiptNumber   String
  purchaseOrderId String?
  supplierId      String?
  /// The supplier's own delivery note or invoice number.
  deliveryNote    String?
  notes           String?
  receivedById    String
  createdAt       DateTime @default(now())

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplier      Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lines         GoodsReceiptLine[]
  bills         SupplierBill[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, createdAt])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                String  @id @default(uuid())
  receiptId         String
  variantId         String
  purchaseOrderLineId String?
  /// What was good and went into stock.
  quantityAccepted  Decimal @db.Decimal(14, 3)
  /// What arrived broken, expired or wrong: NOT put into stock, kept here for a claim on the supplier.
  quantityDamaged   Decimal @default(0) @db.Decimal(14, 3)
  damagedNote       String?
  /// What was paid per unit.
  unitCost          Decimal? @db.Decimal(12, 2)
  batchId           String?

  receipt GoodsReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@index([variantId])
  @@map("goods_receipt_lines")
}

enum SupplierBillStatus {
  OPEN
  PARTLY_PAID
  PAID
  VOID
}

enum BillPaymentMethod {
  CASH
  MPESA
  BANK
  CHEQUE
}

/// What the business owes a supplier for a delivery (the supplier's invoice).
model SupplierBill {
  id              String             @id @default(uuid())
  organizationId  String
  supplierId      String
  /// The supplier's invoice number. One per supplier.
  billNumber      String
  billDate        DateTime           @db.Date
  dueDate         DateTime           @db.Date
  total           Decimal            @db.Decimal(12, 2)
  amountPaid      Decimal            @default(0) @db.Decimal(12, 2)
  /// Taken off what is owed by credit notes (damaged goods, a price correction...). Owed = total - credits - paid.
  creditAmount    Decimal            @default(0) @db.Decimal(12, 2)
  status          SupplierBillStatus @default(OPEN)
  purchaseOrderId String?
  goodsReceiptId  String?
  notes           String?
  createdById     String
  createdAt       DateTime           @default(now())
  voidedAt        DateTime?
  voidReason      String?

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier      Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  receipt       GoodsReceipt?     @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  payments      SupplierBillPayment[]
  credits       SupplierBillCredit[]

  @@unique([organizationId, supplierId, billNumber])
  @@index([organizationId, status, dueDate])
  @@index([supplierId])
  @@map("supplier_bills")
}

/// Money paid to a supplier against a bill (only ever added; a mistake is a note, not an edit).
model SupplierBillPayment {
  id             String                @id @default(uuid())
  organizationId String
  billId         String
  amount         Decimal               @db.Decimal(12, 2)
  method         BillPaymentMethod
  /// M-Pesa code, bank reference or cheque number. The same reference cannot be recorded twice for one method.
  reference      String?
  note           String?
  paidAt         DateTime              @default(now())
  createdById    String
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bill         SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([organizationId, method, reference])
  @@index([billId])
  @@map("supplier_bill_payments")
}

/// A supplier's credit note against a bill: money taken off what is owed (damaged goods, a wrong price). Only ever added.
model SupplierBillCredit {
  id             String   @id @default(uuid())
  organizationId String
  billId         String
  amount         Decimal  @db.Decimal(12, 2)
  reason         String
  /// The supplier's own credit note number, if they sent one.
  reference      String?
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bill         SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("supplier_bill_credits")
}

// ─────────────────────────────────────────────────────────────────────────
// KRA eTIMS (OSCU) integration
// ─────────────────────────────────────────────────────────────────────────

enum EtimsEnvironment {
  SANDBOX
  PRODUCTION
}

enum EtimsDeviceStatus {
  NOT_CONNECTED
  ACTIVE
  FAILED
}

/// A business's eTIMS switch and its taxpayer details. Off until the owner turns it on; nothing about selling changes while it is off.
model EtimsSetting {
  id             String           @id @default(uuid())
  organizationId String           @unique
  enabled        Boolean          @default(false)
  environment    EtimsEnvironment @default(SANDBOX)
  /// The business's KRA PIN, as KRA knows it (11 characters).
  tin            String?
  /// The name KRA returned when the first device was connected.
  taxpayerName   String?
  /// The last number used in an item code (KE2NTBA0000012 ends in a 7-digit counter); each new item takes the next.
  itemSeq        Int              @default(0)
  /// Whether this business sends its sales to KRA. Off until the owner turns it on; only sales made after that moment are ever sent.
  sendSales      Boolean          @default(false)
  salesStartAt   DateTime?
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("etims_settings")
}

/// One OSCU "device" per branch: the branch's KRA branch ID and the device serial KRA approved, plus the key KRA hands back (kept encrypted).
model EtimsDevice {
  id             String            @id @default(uuid())
  organizationId String
  branchId       String            @unique
  /// KRA's two-character branch ID ("00" is the head office).
  bhfId          String
  /// The serial number registered with KRA for this device.
  dvcSrlNo       String
  status         EtimsDeviceStatus @default(NOT_CONNECTED)
  /// The communication key from KRA, encrypted. Never sent to a screen.
  cmcKeyEnc      String?
  dvcId          String?
  sdcId          String?
  mrcNo          String?
  bhfNm          String?
  connectedAt    DateTime?
  lastError      String?
  /// The last invoice number and stock-movement number used on this branch's device (KRA wants each to be a running number).
  invcSeq        Int               @default(0)
  sarSeq         Int               @default(0)
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([organizationId, bhfId])
  @@index([organizationId])
  @@map("etims_devices")
}

/// KRA's code lists (tax types, units, payment methods...), copied down so screens and requests can use them. KRA data, the same for
/// every business, so there is no tenant on it. Kept apart per environment (sandbox and production lists differ).
model EtimsCode {
  environment EtimsEnvironment
  cdCls       String
  cdClsNm     String
  cd          String
  cdNm        String
  cdDesc      String?
  sortOrder   Int              @default(0)
  /// e.g. the tax rate on a tax type
  userDfnCd1  String?
  useYn       String           @default("Y")
  updatedAt   DateTime         @updatedAt

  @@id([environment, cdCls, cd])
  @@index([environment, cdCls])
  @@map("etims_codes")
}

/// KRA's product classification list (what kind of thing an item is, and its usual tax type). Same for every business.
model EtimsItemClass {
  environment EtimsEnvironment
  itemClsCd   String
  itemClsNm   String
  itemClsLvl  Int?
  taxTyCd     String?
  useYn       String           @default("Y")
  updatedAt   DateTime         @updatedAt

  @@id([environment, itemClsCd])
  @@index([environment, itemClsNm])
  @@map("etims_item_classes")
}

/// When each kind of KRA list was last downloaded, so the next request only asks for what changed ("lastReqDt").
model EtimsSyncState {
  environment EtimsEnvironment
  kind        String
  lastReqDt   String
  updatedAt   DateTime         @updatedAt

  @@id([environment, kind])
  @@map("etims_sync_state")
}

enum EtimsItemStatus {
  /// Not sent to KRA yet, or sent and changed since.
  NOT_SENT
  REGISTERED
  REJECTED
}

/// How one product option is known to KRA: the classification and units the owner chose, the unique item code KRA keeps it under, and
/// whether KRA has it. An item must exist at KRA before it can be sold on an eTIMS receipt.
model EtimsItem {
  id             String          @id @default(uuid())
  organizationId String
  variantId      String          @unique
  /// KRA's unique item code (e.g. KE2NTU0000012). Made on the first send and never changed after.
  itemCd         String?
  /// KRA's product classification the owner picked.
  itemClsCd      String?
  /// 1 raw material, 2 finished product, 3 service.
  itemTyCd       String          @default("2")
  pkgUnitCd      String          @default("NT")
  qtyUnitCd      String          @default("U")
  /// Set only to override the tax type taken from the product's tax class (A exempt, B 16%, C 0%, D non-VAT, E 8%).
  taxTyCd        String?
  status         EtimsItemStatus @default(NOT_SENT)
  /// A fingerprint of what KRA was last told, so a later change to the name, price, barcode, tax or classification shows as "needs update".
  sentHash       String?
  lastError      String?
  registeredAt   DateTime?
  updatedAt      DateTime        @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([organizationId, itemCd])
  @@index([organizationId, status])
  @@map("etims_items")
}

enum EtimsDocKind {
  SALE
  CREDIT_NOTE
}

enum EtimsDocStatus {
  /// Waiting to be sent, or sent in part and being retried.
  PENDING
  /// Everything KRA needs has been sent and accepted.
  SENT
  /// KRA refused it; someone has to fix what it complained about and send it again.
  REJECTED
  /// Cannot be sent by the system (for example a part refund); the reason is written on it.
  MANUAL
}

/// One sale (or a credit note for a refunded sale) on its way to KRA: the sale itself, then the stock movement it caused, then the new
/// stock balance of each item - in that order, because KRA refuses stock for a sale it has not got. Each step is remembered, so a retry
/// carries on where it stopped and nothing is ever sent twice.
model EtimsDocument {
  id             String         @id @default(uuid())
  organizationId String
  branchId       String
  kind           EtimsDocKind
  saleId         String
  refundId       String?
  /// "SALE:<id>" or "CREDIT:<id>": one document per sale or refund, ever.
  sourceKey      String
  status         EtimsDocStatus @default(PENDING)
  /// The running numbers KRA was sent (made on the first attempt and kept for every retry).
  invcNo         Int?
  sarNo          Int?
  saleDone       Boolean        @default(false)
  stockDone      Boolean        @default(false)
  masterDone     Boolean        @default(false)
  /// What KRA answered when it took the sale: its receipt number, signature and internal data (these belong on the receipt).
  curRcptNo      Int?
  totRcptNo      Int?
  intrlData      String?
  rcptSign       String?
  sdcDateTime    String?
  /// The Z report that closed this document's day (null until one is made): a document is in exactly one Z report.
  zReportId      String?
  /// The sale as it was sent (without the key), so a credit note can repeat its lines and the screen can show what KRA was told.
  payload        Json?
  attempts       Int            @default(0)
  nextAttemptAt  DateTime?
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceKey])
  @@index([organizationId, status, createdAt])
  @@index([saleId])
  @@index([branchId, zReportId])
  @@map("etims_documents")
}

/// A Z report: the summary of everything KRA signed on one branch since the previous Z report. Kept as made (it is an accounting record).
model EtimsZReport {
  id            String   @id @default(uuid())
  organizationId String
  branchId      String
  /// 1, 2, 3... per branch, with no gaps.
  number        Int
  fromAt        DateTime
  toAt          DateTime
  totals        Json
  createdByName String?
  createdAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([branchId, number])
  @@index([organizationId, branchId, createdAt])
  @@map("etims_z_reports")
}

/// A receipt printed again as a COPY (the daily reports count them).
model EtimsReceiptPrint {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String
  saleId         String
  /// SALE or CREDIT: which of the sale's two receipts was copied.
  kind           String
  createdByName  String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, branchId, createdAt])
  @@map("etims_receipt_prints")
}
